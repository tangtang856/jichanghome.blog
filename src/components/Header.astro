---
interface Props {
  currentNav?: string;
}

const { currentNav = '' } = Astro.props;

const navItems = [
  { label: '首页', href: '/', id: 'home' },
  { label: '机场推荐', href: '/recommend/', id: 'recommend' },
  { label: '节点排行', href: '/ranking/', id: 'ranking' },
  { label: '品牌评测', href: '/airport/', id: 'airport' },
  { label: '机场对比', href: '/compare/', id: 'compare' },
  { label: '使用教程', href: '/guides/', id: 'guides' },
  { label: '选型指南', href: '/blog/', id: 'blog' },
];
---

<header class="site-header sticky top-0 z-50 bg-[#030712]/85 backdrop-blur-md border-b border-slate-800/80 shadow-md shadow-black/40 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between relative">
    <!-- Left: Logo -->
    <a href="/" class="flex items-center gap-2.5 text-xl font-black text-white tracking-tight hover:text-blue-400 transition-colors group shrink-0 z-10">
      <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-700 text-white flex items-center justify-center font-black text-sm shadow-md shadow-blue-500/30 group-hover:scale-105 transition-transform">JH</span>
      <span class="flex flex-col">
        <span class="leading-none font-extrabold text-white group-hover:text-blue-400 transition-colors">机场之家</span>
        <span class="text-[10px] text-slate-400 font-semibold tracking-wider uppercase leading-tight mt-0.5">jichanghome.blog</span>
      </span>
    </a>

    <!-- Center: Desktop Navigation (放中间) -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2 absolute left-1/2 -translate-x-1/2" aria-label="主导航">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`px-3 py-1.5 rounded-lg text-sm font-semibold transition-all whitespace-nowrap ${
            currentNav === item.id
              ? 'text-blue-400 bg-blue-950/70 border border-blue-500/40 font-bold'
              : 'text-slate-300 hover:text-white hover:bg-slate-800/60'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Right: Action Buttons (联络我们 + 快速比价) -->
    <div class="hidden md:flex items-center gap-2.5 shrink-0 z-20">
      <!-- Contact Popover Trigger -->
      <div class="relative" id="contactDropdownContainer">
        <button
          type="button"
          id="contactBtn"
          class="px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-800/90 hover:bg-slate-700/90 text-slate-200 hover:text-white border border-slate-700/80 shadow-sm flex items-center gap-1.5 transition-all active:scale-95 cursor-pointer whitespace-nowrap group"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>联络我们</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-white transition-transform duration-200" id="contactChevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <!-- Dropdown Popover Card -->
        <div
          id="contactPopover"
          class="hidden absolute right-0 top-full mt-2 w-80 sm:w-96 bg-[#0f172a]/95 backdrop-blur-xl border border-slate-700/90 rounded-2xl shadow-2xl p-5 text-white z-50 transition-all"
        >
          <!-- Popover Header -->
          <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-800">
            <div>
              <div class="flex items-center gap-2">
                <span class="text-sm font-black text-white">联系我们 · 官方通道</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">即时响应</span>
              </div>
              <p class="text-[11px] text-slate-400 mt-0.5">商务合作 · 品牌送测 · 节点收录 · 勘误反馈</p>
            </div>
            <button
              type="button"
              id="closeContactBtn"
              class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition-colors"
              aria-label="关闭"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <!-- Contact Options -->
          <div class="space-y-3">
            <!-- Telegram Card -->
            <div class="bg-gradient-to-r from-sky-950/60 to-blue-950/40 border border-sky-500/30 rounded-xl p-3.5 hover:border-sky-500/50 transition-all">
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-lg bg-sky-500 text-white flex items-center justify-center shadow-sm shadow-sky-500/30">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="text-xs font-bold text-white flex items-center gap-1.5">
                      <span>Telegram (电报直连)</span>
                      <span class="text-[10px] text-sky-400 font-mono">在线</span>
                    </div>
                    <div class="text-[11px] text-slate-400">商务合作 · 节点评测即时对接</div>
                  </div>
                </div>
              </div>

              <div class="flex items-center justify-between bg-slate-900/80 rounded-lg px-2.5 py-1.5 border border-slate-800 mb-2.5">
                <span class="font-mono text-xs text-sky-300 font-bold select-all">@xintangtang</span>
                <button
                  type="button"
                  class="copy-btn text-[11px] font-semibold text-slate-400 hover:text-white px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 transition-colors"
                  data-copy="@xintangtang"
                >
                  复制
                </button>
              </div>

              <a
                href="https://t.me/xintangtang"
                target="_blank"
                rel="noopener nofollow"
                class="w-full flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg text-xs font-bold bg-sky-500 hover:bg-sky-400 text-white shadow-sm shadow-sky-500/20 transition-all active:scale-95"
              >
                <span>打开 Telegram 立即沟通</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>
            </div>

            <!-- Gmail Card -->
            <div class="bg-gradient-to-r from-rose-950/40 to-slate-900/60 border border-rose-500/30 rounded-xl p-3.5 hover:border-rose-500/50 transition-all">
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-lg bg-rose-500 text-white flex items-center justify-center shadow-sm shadow-rose-500/30">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="text-xs font-bold text-white flex items-center gap-1.5">
                      <span>官方工作邮箱 (Gmail)</span>
                    </div>
                    <div class="text-[11px] text-slate-400">商务咨询 · 24小时内答复</div>
                  </div>
                </div>
              </div>

              <div class="flex items-center justify-between bg-slate-900/80 rounded-lg px-2.5 py-1.5 border border-slate-800 mb-2.5">
                <span class="font-mono text-xs text-rose-300 font-bold select-all truncate max-w-[200px]">xintangtang888@gmail.com</span>
                <button
                  type="button"
                  class="copy-btn text-[11px] font-semibold text-slate-400 hover:text-white px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 transition-colors shrink-0"
                  data-copy="xintangtang888@gmail.com"
                >
                  复制
                </button>
              </div>

              <a
                href="mailto:xintangtang888@gmail.com"
                class="w-full flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white border border-slate-700 transition-all active:scale-95"
              >
                <span>发送工作邮件</span>
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- Bottom Security Statement -->
          <div class="mt-3.5 pt-3 border-t border-slate-800 text-[10px] text-slate-400 flex items-start gap-1.5 leading-relaxed">
            <span class="text-amber-400 shrink-0">🛡️</span>
            <span>请认准唯一官方 TG 账号 <strong class="text-sky-300 font-mono">@xintangtang</strong> 与 Gmail 邮箱，谨防虚假冒充。</span>
          </div>
        </div>
      </div>

      <!-- Quick Compare Button -->
      <a
        href="/compare/"
        class="px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-blue-600 text-white shadow-sm shadow-blue-600/30 hover:bg-blue-500 hover:shadow-md transition-all active:scale-95 whitespace-nowrap"
      >
        快速比价
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobileMenuBtn"
      class="md:hidden p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none z-10"
      aria-label="展开导航菜单"
      aria-expanded="false"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobileDrawer" class="hidden md:hidden border-b border-slate-800 bg-[#0f172a]/95 backdrop-blur-md px-4 pt-2 pb-5 space-y-2 shadow-2xl">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`block px-3 py-2 rounded-md text-base font-medium ${
          currentNav === item.id
            ? 'text-blue-400 bg-blue-950/70 font-bold'
            : 'text-slate-300 hover:text-white hover:bg-slate-800/60'
        }`}
      >
        {item.label}
      </a>
    ))}

    <!-- Mobile Contact Block -->
    <div class="pt-3 border-t border-slate-800/90">
      <div class="text-xs font-bold text-slate-400 px-1 mb-2">联络我们 / 商务对接</div>
      <div class="grid grid-cols-2 gap-2">
        <a
          href="https://t.me/xintangtang"
          target="_blank"
          rel="noopener nofollow"
          class="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-lg text-xs font-bold bg-sky-600/20 text-sky-300 border border-sky-500/30 hover:bg-sky-600/30 transition-colors"
        >
          <span>TG: @xintangtang</span>
        </a>
        <a
          href="mailto:xintangtang888@gmail.com"
          class="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-lg text-xs font-bold bg-rose-600/20 text-rose-300 border border-rose-500/30 hover:bg-rose-600/30 transition-colors"
        >
          <span>Gmail 联络</span>
        </a>
      </div>
    </div>

    <div class="pt-2">
      <a
        href="/compare/"
        class="block w-full text-center px-4 py-2.5 rounded-lg text-sm font-bold bg-blue-600 text-white shadow-sm hover:bg-blue-500"
      >
        在线横向比价工具 &rarr;
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile drawer toggle
  const mobileBtn = document.getElementById('mobileMenuBtn');
  const drawer = document.getElementById('mobileDrawer');
  if (mobileBtn && drawer) {
    mobileBtn.addEventListener('click', () => {
      const isHidden = drawer.classList.contains('hidden');
      if (isHidden) {
        drawer.classList.remove('hidden');
        mobileBtn.setAttribute('aria-expanded', 'true');
      } else {
        drawer.classList.add('hidden');
        mobileBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Contact popover toggle
  const contactBtn = document.getElementById('contactBtn');
  const contactPopover = document.getElementById('contactPopover');
  const contactChevron = document.getElementById('contactChevron');
  const closeContactBtn = document.getElementById('closeContactBtn');
  const container = document.getElementById('contactDropdownContainer');

  function openContact() {
    if (contactPopover) {
      contactPopover.classList.remove('hidden');
      contactBtn?.setAttribute('aria-expanded', 'true');
      contactChevron?.classList.add('rotate-180');
    }
  }

  function closeContact() {
    if (contactPopover) {
      contactPopover.classList.add('hidden');
      contactBtn?.setAttribute('aria-expanded', 'false');
      contactChevron?.classList.remove('rotate-180');
    }
  }

  if (contactBtn && contactPopover) {
    contactBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = contactPopover.classList.contains('hidden');
      if (isHidden) {
        openContact();
      } else {
        closeContact();
      }
    });

    closeContactBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeContact();
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (container && !container.contains(e.target as Node)) {
        closeContact();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeContact();
      }
    });
  }

  // Copy buttons
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const target = btn as HTMLElement;
      const copyText = target.getAttribute('data-copy') || '';
      if (copyText) {
        navigator.clipboard.writeText(copyText).then(() => {
          const originalText = target.textContent;
          target.textContent = '已复制 ✓';
          target.classList.add('!text-emerald-400', '!bg-emerald-950/60', '!border-emerald-500/40');
          setTimeout(() => {
            target.textContent = originalText;
            target.classList.remove('!text-emerald-400', '!bg-emerald-950/60', '!border-emerald-500/40');
          }, 2000);
        }).catch(() => {
          // Fallback if clipboard API is restricted
          prompt('请手动复制联系方式：', copyText);
        });
      }
    });
  });
</script>
