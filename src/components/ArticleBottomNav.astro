---
interface ArticleItem {
  slug: string;
  h1: string;
  category: string;
  readTime?: string;
  desc?: string;
  date?: string;
}

interface Props {
  nextArticle: ArticleItem;
  prevArticle: ArticleItem;
  currentIndex: number;
  totalCount: number;
  basePath: 'blog' | 'guides';
  typeLabel?: string;
}

const {
  nextArticle,
  prevArticle,
  currentIndex,
  totalCount,
  basePath = 'blog',
  typeLabel = '文章'
} = Astro.props;

const prefix = basePath === 'blog' ? '/blog/' : '/guides/';
---

<div class="mt-12 space-y-8">
  <!-- 1. Spotlight Next Article Hero Jump Box -->
  <div class="bg-gradient-to-br from-blue-900/40 via-slate-900/60 to-indigo-950/50 rounded-2xl p-6 sm:p-8 border border-blue-500/30 shadow-xl relative overflow-hidden backdrop-blur-md">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-blue-600 text-white shadow-sm">
        🚀 顺延探索 · 下一篇{typeLabel}
      </span>
      <span class="text-xs font-semibold text-slate-400">
        进度：第 {currentIndex + 1} 篇 / 共 {totalCount} 篇
      </span>
    </div>

    <div class="space-y-3 my-4">
      <div class="flex items-center gap-3 text-xs text-slate-400">
        <span class="px-2 py-0.5 rounded bg-blue-950/80 text-blue-300 border border-blue-800/60 font-semibold">
          {nextArticle.category}
        </span>
        {nextArticle.readTime && <span>阅读时长：{nextArticle.readTime}</span>}
        {nextArticle.date && <span>• 发布：{nextArticle.date}</span>}
      </div>

      <h3 class="text-xl sm:text-2xl font-black text-white leading-snug hover:text-blue-400 transition-colors">
        <a href={`${prefix}${nextArticle.slug}/`}>{nextArticle.h1}</a>
      </h3>

      {nextArticle.desc && (
        <p class="text-xs sm:text-sm text-slate-300 line-clamp-2 leading-relaxed">
          {nextArticle.desc}
        </p>
      )}
    </div>

    <div class="pt-2">
      <a
        href={`${prefix}${nextArticle.slug}/`}
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs sm:text-sm font-black shadow-lg shadow-blue-500/30 hover:shadow-xl transition-all active:scale-95 group"
      >
        <span>立即跳转到下一篇{typeLabel}</span>
        <svg class="w-4 h-4 group-hover:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>
  </div>

  <!-- 2. Dual-Column Previous / Next Pagination Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <!-- Prev -->
    <a
      href={`${prefix}${prevArticle.slug}/`}
      class="p-5 rounded-2xl bg-white border border-slate-200/90 hover:border-blue-400 hover:shadow-md transition-all group flex flex-col justify-between"
    >
      <div>
        <span class="inline-flex items-center gap-1 text-[11px] font-bold text-slate-400 group-hover:text-blue-600 transition-colors mb-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          上一篇{typeLabel}
        </span>
        <h4 class="text-xs sm:text-sm font-bold text-slate-900 group-hover:text-blue-600 line-clamp-2 leading-snug">
          {prevArticle.h1}
        </h4>
      </div>
      <span class="text-[10px] text-slate-400 mt-2 block">{prevArticle.category}</span>
    </a>

    <!-- Next -->
    <a
      href={`${prefix}${nextArticle.slug}/`}
      class="p-5 rounded-2xl bg-white border border-slate-200/90 hover:border-blue-400 hover:shadow-md transition-all group flex flex-col justify-between text-right"
    >
      <div>
        <span class="inline-flex items-center justify-end gap-1 text-[11px] font-bold text-slate-400 group-hover:text-blue-600 transition-colors mb-1.5">
          下一篇{typeLabel}
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </span>
        <h4 class="text-xs sm:text-sm font-bold text-slate-900 group-hover:text-blue-600 line-clamp-2 leading-snug">
          {nextArticle.h1}
        </h4>
      </div>
      <span class="text-[10px] text-slate-400 mt-2 block">{nextArticle.category}</span>
    </a>
  </div>

  <!-- 3. Comprehensive Internal Linking Hub (优质内链枢纽) -->
  <div class="p-6 rounded-2xl bg-white border border-slate-200/90 shadow-sm">
    <div class="border-b border-slate-200 pb-3 mb-4 flex items-center justify-between">
      <h3 class="text-xs sm:text-sm font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
        <span class="w-2 h-4 rounded bg-blue-600"></span>
        全站核心专题与实用工具互联导航
      </h3>
      <a href="/ranking/" class="text-[11px] font-bold text-blue-600 hover:underline">
        综合排行榜 &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
      <!-- Col 1: 热门专线机场评测 -->
      <div>
        <h4 class="font-extrabold text-slate-800 mb-2.5 flex items-center gap-1.5">
          <span>🏆</span>
          <span>高分稳定机场评测</span>
        </h4>
        <ul class="space-y-2 text-slate-600">
          <li>
            <a href="/airport/breezenet/" class="hover:text-blue-600 transition-colors flex items-center justify-between">
              <span>#1 微风网络 Breezenet</span>
              <span class="text-[10px] text-slate-400">¥8/月</span>
            </a>
          </li>
          <li>
            <a href="/airport/muguang/" class="hover:text-blue-600 transition-colors flex items-center justify-between">
              <span>#2 暮光网络 Muguang</span>
              <span class="text-[10px] text-slate-400">¥20/月</span>
            </a>
          </li>
          <li>
            <a href="/airport/feimaoyun/" class="hover:text-blue-600 transition-colors flex items-center justify-between">
              <span>#3 飞猫云 Feimaoyun</span>
              <span class="text-[10px] text-slate-400">¥7/月</span>
            </a>
          </li>
          <li>
            <a href="/airport/" class="text-blue-600 font-semibold hover:underline block pt-1">
              查看全部 14 家独立测速报告 &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 2: 全平台客户端教程 -->
      <div>
        <h4 class="font-extrabold text-slate-800 mb-2.5 flex items-center gap-1.5">
          <span>📱</span>
          <span>客户端保姆级教程</span>
        </h4>
        <ul class="space-y-2 text-slate-600">
          <li>
            <a href="/guides/windows/" class="hover:text-blue-600 transition-colors">
              Windows 配置 Clash Verge Rev 教程
            </a>
          </li>
          <li>
            <a href="/guides/ios/" class="hover:text-blue-600 transition-colors">
              iOS 苹果小火箭 Shadowrocket 配置
            </a>
          </li>
          <li>
            <a href="/guides/android/" class="hover:text-blue-600 transition-colors">
              Android 安卓端 Clash 与 v2rayNG 教学
            </a>
          </li>
          <li>
            <a href="/guides/macos/" class="hover:text-blue-600 transition-colors">
              macOS 苹果电脑配置 Clash Verge 指南
            </a>
          </li>
          <li>
            <a href="/guides/" class="text-blue-600 font-semibold hover:underline block pt-1">
              查看全部 30 篇客户端实操教程 &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: 核心选型与对比工具 -->
      <div>
        <h4 class="font-extrabold text-slate-800 mb-2.5 flex items-center gap-1.5">
          <span>⚖️</span>
          <span>按需选型与比价工具</span>
        </h4>
        <ul class="space-y-2 text-slate-600">
          <li>
            <a href="/compare/" class="hover:text-blue-600 transition-colors font-medium">
              在线机场横向比价与测速工具 ↗
            </a>
          </li>
          <li>
            <a href="/recommend/budget/" class="hover:text-blue-600 transition-colors">
              学生党低预算与平价大流量专区
            </a>
          </li>
          <li>
            <a href="/recommend/premium/" class="hover:text-blue-600 transition-colors">
              晚高峰防拥堵纯 IPLC/IEPL 内网专线
            </a>
          </li>
          <li>
            <a href="/recommend/ai/" class="hover:text-blue-600 transition-colors">
              ChatGPT/Claude 原生落地防封节点
            </a>
          </li>
          <li>
            <a href="/glossary/iplc/" class="hover:text-blue-600 transition-colors">
              术语百科：什么是 IPLC 物理专线？
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>
