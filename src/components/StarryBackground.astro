---
// StarryBackground.astro - 纯黑深空 · 璀璨晶莹小星星与梦幻星河动态背景 (彻底修复无硬边圆斑，纯粹高奢星空)
---

<div id="starry-container" class="fixed inset-0 pointer-events-none z-0 overflow-hidden bg-[#030712]" aria-hidden="true">
  <canvas id="starryCanvas" class="w-full h-full block"></canvas>
</div>

<script is:inline>
  (function initPristineStarfield() {
    var canvas = document.getElementById('starryCanvas');
    if (!canvas) return;

    var ctx = canvas.getContext('2d', { alpha: false });
    if (!ctx) return;

    var width = window.innerWidth || 1440;
    var height = window.innerHeight || 900;
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var animating = false;
    var lastTime = performance.now();

    // 纯净宝石星辉配色（白炽纯白内核 + 通透发光晕）
    var STAR_PALETTES = [
      { core: '#ffffff', glow: 'rgba(56, 189, 248, 0.9)', aura: 'rgba(56, 189, 248, 0.25)', hex: '#38bdf8' },  // 冰钻天青
      { core: '#ffffff', glow: 'rgba(251, 191, 36, 0.95)', aura: 'rgba(251, 191, 36, 0.28)', hex: '#fbbf24' },  // 晨曦香槟金
      { core: '#ffffff', glow: 'rgba(192, 132, 252, 0.9)', aura: 'rgba(192, 132, 252, 0.25)', hex: '#c084fc' }, // 梦幻紫罗兰
      { core: '#ffffff', glow: 'rgba(96, 165, 250, 0.9)', aura: 'rgba(96, 165, 250, 0.25)', hex: '#60a5fa' },  // 苍穹星蓝
      { core: '#ffffff', glow: 'rgba(244, 114, 182, 0.9)', aura: 'rgba(244, 114, 182, 0.25)', hex: '#f472b6' }, // 蔷薇粉钻
      { core: '#ffffff', glow: 'rgba(52, 211, 153, 0.9)', aura: 'rgba(52, 211, 153, 0.25)', hex: '#34d399' }  // 极光翡翠
    ];

    var stars = [];
    var shootingStars = [];
    var mouseSparkles = [];

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function createStar(initial) {
      var palette = STAR_PALETTES[Math.floor(Math.random() * STAR_PALETTES.length)];
      var rand = Math.random();
      var type;
      var size;

      if (rand < 0.35) {
        type = 'diamond'; // 35% ✦ 四角细长晶钻闪烁星
        size = 5 + Math.random() * 6.5;
      } else if (rand < 0.55) {
        type = 'octa'; // 20% ✧ 八角超新星芒
        size = 5.5 + Math.random() * 7;
      } else if (rand < 0.75) {
        type = 'star5'; // 20% ★ 可爱立体五角星
        size = 4 + Math.random() * 5;
      } else if (rand < 0.88) {
        type = 'cross'; // 13% ✚ 十字芒星
        size = 3.5 + Math.random() * 4.5;
      } else {
        type = 'pinprick'; // 12% • 纯白微晶远星点
        size = 1.2 + Math.random() * 2.0;
      }

      return {
        x: Math.random() * width,
        y: initial ? Math.random() * height : height + 15,
        type: type,
        size: size,
        palette: palette,
        baseAlpha: 0.4 + Math.random() * 0.55,
        alpha: 0.5,
        twinkleSpeed: 0.016 + Math.random() * 0.038,
        twinklePhase: Math.random() * Math.PI * 2,
        vx: (Math.random() - 0.5) * 0.20,
        vy: -0.08 - Math.random() * 0.18, // 缓缓升腾
        rotation: Math.random() * Math.PI * 2,
        rotationSpeed: (Math.random() - 0.5) * 0.012
      };
    }

    function initStars() {
      stars = [];
      var count = Math.max(65, Math.min(100, Math.floor((width * height) / 13000)));
      for (var i = 0; i < count; i++) {
        stars.push(createStar(true));
      }
    }

    function maybeSpawnShootingStar() {
      if (Math.random() < 0.014 && shootingStars.length < 2) {
        var palette = STAR_PALETTES[Math.floor(Math.random() * STAR_PALETTES.length)];
        shootingStars.push({
          x: Math.random() * width * 0.8,
          y: Math.random() * (height * 0.35),
          len: 110 + Math.random() * 150,
          speed: 14 + Math.random() * 8,
          angle: (Math.PI / 5) + (Math.random() * Math.PI / 18),
          alpha: 1.0,
          width: 1.8 + Math.random() * 1.2,
          color: palette.hex
        });
      }
    }

    // 1. 绘制四角晶钻闪耀星 (✦ 纯净 needle 钻石星，渐变衰减无硬边)
    function drawDiamondStar(c, x, y, size, p, alpha, rot) {
      c.save();
      c.translate(x, y);
      c.rotate(rot);

      // 柔和微晕渐变（完全平滑淡出到透明，绝无硬边圆圈）
      var auraR = size * 2.2;
      var g = c.createRadialGradient(0, 0, 0, 0, 0, auraR);
      g.addColorStop(0, p.glow);
      g.addColorStop(0.3, p.aura);
      g.addColorStop(1, 'rgba(3, 7, 18, 0)');
      c.fillStyle = g;
      c.beginPath();
      c.arc(0, 0, auraR, 0, Math.PI * 2);
      c.fill();

      // 四角钻石纤细光芒
      c.fillStyle = p.glow;
      c.globalAlpha = alpha;
      var inner = size * 0.16;
      c.beginPath();
      c.moveTo(0, -size);
      c.quadraticCurveTo(0, -inner, inner, 0);
      c.quadraticCurveTo(0, inner, 0, size);
      c.quadraticCurveTo(0, inner, -inner, 0);
      c.quadraticCurveTo(0, -inner, 0, -size);
      c.closePath();
      c.fill();

      // 纯白高亮极光晶核
      c.fillStyle = '#ffffff';
      c.globalAlpha = Math.min(1.0, alpha * 1.25);
      c.beginPath();
      c.arc(0, 0, Math.max(1.2, size * 0.22), 0, Math.PI * 2);
      c.fill();

      c.restore();
    }

    // 2. 绘制八角超新星芒 (✧)
    function drawOctaStar(c, x, y, size, p, alpha, rot) {
      c.save();
      c.translate(x, y);
      c.rotate(rot);

      // 平滑星晕
      var auraR = size * 2.0;
      var g = c.createRadialGradient(0, 0, 0, 0, 0, auraR);
      g.addColorStop(0, p.glow);
      g.addColorStop(0.35, p.aura);
      g.addColorStop(1, 'rgba(3, 7, 18, 0)');
      c.fillStyle = g;
      c.beginPath();
      c.arc(0, 0, auraR, 0, Math.PI * 2);
      c.fill();

      // 主4长芒
      c.fillStyle = p.glow;
      c.globalAlpha = alpha;
      var inner = size * 0.14;
      c.beginPath();
      c.moveTo(0, -size);
      c.quadraticCurveTo(0, -inner, inner, 0);
      c.quadraticCurveTo(0, inner, 0, size);
      c.quadraticCurveTo(0, inner, -inner, 0);
      c.quadraticCurveTo(0, -inner, 0, -size);
      c.closePath();
      c.fill();

      // 45° 4短芒
      c.rotate(Math.PI / 4);
      c.globalAlpha = alpha * 0.6;
      var sub = size * 0.5;
      var subIn = inner * 0.6;
      c.beginPath();
      c.moveTo(0, -sub);
      c.quadraticCurveTo(0, -subIn, subIn, 0);
      c.quadraticCurveTo(0, subIn, 0, sub);
      c.quadraticCurveTo(0, subIn, -subIn, 0);
      c.quadraticCurveTo(0, -subIn, 0, -sub);
      c.closePath();
      c.fill();

      // 白炽星心
      c.fillStyle = '#ffffff';
      c.globalAlpha = 1.0;
      c.beginPath();
      c.arc(0, 0, Math.max(1.1, size * 0.2), 0, Math.PI * 2);
      c.fill();

      c.restore();
    }

    // 3. 绘制可爱立体五角星 (★)
    function drawFivePointStar(c, x, y, r, p, alpha, rot) {
      c.save();
      c.translate(x, y);
      c.rotate(rot);

      // 平滑外晕
      var auraR = r * 1.8;
      var g = c.createRadialGradient(0, 0, 0, 0, 0, auraR);
      g.addColorStop(0, p.glow);
      g.addColorStop(0.4, p.aura);
      g.addColorStop(1, 'rgba(3, 7, 18, 0)');
      c.fillStyle = g;
      c.beginPath();
      c.arc(0, 0, auraR, 0, Math.PI * 2);
      c.fill();

      // 五角星形状
      c.fillStyle = p.glow;
      c.globalAlpha = alpha;
      c.beginPath();
      var innerR = r * 0.42;
      for (var i = 0; i < 5; i++) {
        var a1 = (i * 72 - 90) * Math.PI / 180;
        var a2 = ((i * 72 + 36) - 90) * Math.PI / 180;
        var x1 = Math.cos(a1) * r;
        var y1 = Math.sin(a1) * r;
        var x2 = Math.cos(a2) * innerR;
        var y2 = Math.sin(a2) * innerR;
        if (i === 0) c.moveTo(x1, y1);
        else c.lineTo(x1, y1);
        c.lineTo(x2, y2);
      }
      c.closePath();
      c.fill();

      // 星心白色反光
      c.fillStyle = '#ffffff';
      c.globalAlpha = 1.0;
      c.beginPath();
      c.arc(0, 0, r * 0.25, 0, Math.PI * 2);
      c.fill();

      c.restore();
    }

    // 4. 绘制精致十字光星 (✚)
    function drawCrossStar(c, x, y, size, p, alpha, rot) {
      c.save();
      c.translate(x, y);
      c.rotate(rot);

      c.strokeStyle = p.glow;
      c.lineWidth = 1.4;
      c.lineCap = 'round';
      c.globalAlpha = alpha;

      c.beginPath();
      c.moveTo(-size, 0);
      c.lineTo(size, 0);
      c.moveTo(0, -size);
      c.lineTo(0, size);
      c.stroke();

      c.fillStyle = '#ffffff';
      c.globalAlpha = 1.0;
      c.beginPath();
      c.arc(0, 0, 1.2, 0, Math.PI * 2);
      c.fill();

      c.restore();
    }

    // 5. 绘制晶莹远星微点 (• 绝无硬边，平滑光点)
    function drawPinprickStar(c, x, y, r, p, alpha) {
      c.save();
      var g = c.createRadialGradient(x, y, 0, x, y, r * 2.2);
      g.addColorStop(0, '#ffffff');
      g.addColorStop(0.35, p.glow);
      g.addColorStop(1, 'rgba(3, 7, 18, 0)');

      c.fillStyle = g;
      c.globalAlpha = alpha;
      c.beginPath();
      c.arc(x, y, r * 2.2, 0, Math.PI * 2);
      c.fill();
      c.restore();
    }

    // 极光星云微光（极其柔和深邃，完全融入深黑夜空）
    var nebulaAngle = 0;
    function drawSubtleNebula(c) {
      nebulaAngle += 0.0018;
      var ox = Math.sin(nebulaAngle) * 50;
      var oy = Math.cos(nebulaAngle * 0.8) * 35;

      c.save();
      // 幽蓝深空星云
      var g1 = c.createRadialGradient(width * 0.25 + ox, height * 0.25 + oy, 0, width * 0.25 + ox, height * 0.25 + oy, Math.max(width, height) * 0.45);
      g1.addColorStop(0, 'rgba(14, 165, 233, 0.12)');
      g1.addColorStop(0.65, 'rgba(14, 165, 233, 0.025)');
      g1.addColorStop(1, 'rgba(3, 7, 18, 0)');
      c.fillStyle = g1;
      c.fillRect(0, 0, width, height);

      // 紫霞星尘
      var g2 = c.createRadialGradient(width * 0.8 - ox, height * 0.45 - oy, 0, width * 0.8 - ox, height * 0.45 - oy, Math.max(width, height) * 0.4);
      g2.addColorStop(0, 'rgba(147, 51, 234, 0.10)');
      g2.addColorStop(0.65, 'rgba(147, 51, 234, 0.02)');
      g2.addColorStop(1, 'rgba(3, 7, 18, 0)');
      c.fillStyle = g2;
      c.fillRect(0, 0, width, height);
      c.restore();
    }

    // 动画主循环
    function tick(now) {
      if (!animating) return;

      // 1. 彻底纯净重置画布为深空黑底 (#030712)
      ctx.save();
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.globalAlpha = 1.0;
      ctx.fillStyle = '#030712';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.restore();

      // 2. 柔和深空星云微光
      drawSubtleNebula(ctx);

      // 3. 纤细精致星宿星轨连线 (薄如蝉翼，近距自然交织)
      var maxDist = 75;
      var maxDistSq = maxDist * maxDist;
      ctx.save();
      for (var i = 0; i < stars.length; i++) {
        var s1 = stars[i];
        var connections = 0;
        for (var j = i + 1; j < stars.length; j++) {
          if (connections >= 2) break;
          var s2 = stars[j];
          var dx = s1.x - s2.x;
          var dy = s1.y - s2.y;
          var distSq = dx * dx + dy * dy;

          if (distSq < maxDistSq) {
            connections++;
            var dist = Math.sqrt(distSq);
            var lineAlpha = (1 - dist / maxDist) * 0.20 * Math.min(s1.alpha, s2.alpha);
            ctx.strokeStyle = s1.palette.hex;
            ctx.globalAlpha = lineAlpha;
            ctx.lineWidth = 0.85;
            ctx.beginPath();
            ctx.moveTo(s1.x, s1.y);
            ctx.lineTo(s2.x, s2.y);
            ctx.stroke();
          }
        }
      }
      ctx.restore();

      // 4. 精细渲染各种各样的小星星
      for (var k = 0; k < stars.length; k++) {
        var s = stars[k];

        // 呼吸闪烁
        s.twinklePhase += s.twinkleSpeed;
        var pulse = (Math.sin(s.twinklePhase) + 1) / 2;
        s.alpha = s.baseAlpha * 0.35 + pulse * (s.baseAlpha * 0.85);

        // 缓缓向上浮动
        s.x += s.vx;
        s.y += s.vy;
        s.rotation += s.rotationSpeed;

        // 边界循环
        if (s.y < -25) {
          s.y = height + 25;
          s.x = Math.random() * width;
        }
        if (s.x < -25) s.x = width + 25;
        if (s.x > width + 25) s.x = -25;

        // 按形态渲染各种璀璨小星星
        switch (s.type) {
          case 'diamond':
            drawDiamondStar(ctx, s.x, s.y, s.size, s.palette, s.alpha, s.rotation);
            break;
          case 'octa':
            drawOctaStar(ctx, s.x, s.y, s.size, s.palette, s.alpha, s.rotation);
            break;
          case 'star5':
            drawFivePointStar(ctx, s.x, s.y, s.size, s.palette, s.alpha, s.rotation);
            break;
          case 'cross':
            drawCrossStar(ctx, s.x, s.y, s.size, s.palette, s.alpha, s.rotation);
            break;
          case 'pinprick':
            drawPinprickStar(ctx, s.x, s.y, s.size, s.palette, s.alpha);
            break;
        }
      }

      // 5. 渲染优雅流星
      maybeSpawnShootingStar();
      for (var m = shootingStars.length - 1; m >= 0; m--) {
        var meteor = shootingStars[m];
        meteor.x += Math.cos(meteor.angle) * meteor.speed;
        meteor.y += Math.sin(meteor.angle) * meteor.speed;
        meteor.alpha -= 0.015;

        if (meteor.alpha > 0) {
          ctx.save();
          var tailX = meteor.x - meteor.len * Math.cos(meteor.angle);
          var tailY = meteor.y - meteor.len * Math.sin(meteor.angle);

          var grad = ctx.createLinearGradient(meteor.x, meteor.y, tailX, tailY);
          grad.addColorStop(0, '#ffffff');
          grad.addColorStop(0.25, meteor.color);
          grad.addColorStop(0.65, 'rgba(192, 132, 252, 0.3)');
          grad.addColorStop(1, 'rgba(3, 7, 18, 0)');

          ctx.strokeStyle = grad;
          ctx.lineWidth = meteor.width;
          ctx.lineCap = 'round';
          ctx.globalAlpha = meteor.alpha;
          ctx.beginPath();
          ctx.moveTo(meteor.x, meteor.y);
          ctx.lineTo(tailX, tailY);
          ctx.stroke();

          // 流星炽热核
          ctx.fillStyle = '#ffffff';
          ctx.globalAlpha = Math.min(1.0, meteor.alpha * 1.5);
          ctx.beginPath();
          ctx.arc(meteor.x, meteor.y, meteor.width * 1.1, 0, Math.PI * 2);
          ctx.fill();

          ctx.restore();
        }

        if (meteor.alpha <= 0 || meteor.x > width + meteor.len || meteor.y > height + meteor.len) {
          shootingStars.splice(m, 1);
        }
      }

      // 6. 渲染鼠标交互微粒 (晶莹小星尘)
      for (var p = mouseSparkles.length - 1; p >= 0; p--) {
        var ms = mouseSparkles[p];
        ms.x += ms.vx;
        ms.y += ms.vy;
        ms.alpha -= ms.decay;
        ms.rotation += 0.04;

        if (ms.alpha > 0) {
          drawDiamondStar(ctx, ms.x, ms.y, ms.size, ms.palette, ms.alpha, ms.rotation);
        }

        if (ms.alpha <= 0) {
          mouseSparkles.splice(p, 1);
        }
      }

      requestAnimationFrame(tick);
    }

    // 鼠标交互监听
    var lastMouseTime = 0;
    window.addEventListener('mousemove', function(e) {
      var now = performance.now();
      if (now - lastMouseTime > 55 && mouseSparkles.length < 16) {
        lastMouseTime = now;
        var p = STAR_PALETTES[Math.floor(Math.random() * STAR_PALETTES.length)];
        mouseSparkles.push({
          x: e.clientX,
          y: e.clientY,
          vx: (Math.random() - 0.5) * 1.4,
          vy: (Math.random() - 0.5) * 1.4 - 0.4,
          size: 3.5 + Math.random() * 4,
          palette: p,
          alpha: 0.95,
          decay: 0.025,
          rotation: Math.random() * Math.PI
        });
      }
    }, { passive: true });

    // 窗口可见性与焦点事件（确保切屏回来动画永不中断）
    function resumeAnimation() {
      if (!animating) {
        animating = true;
        lastTime = performance.now();
        requestAnimationFrame(tick);
      }
    }

    document.addEventListener('visibilitychange', function() {
      if (!document.hidden) {
        resumeAnimation();
      } else {
        animating = false;
      }
    });

    window.addEventListener('focus', resumeAnimation);
    window.addEventListener('pageshow', resumeAnimation);

    // 窗口尺寸自适应
    var resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() {
        resize();
        initStars();
      }, 120);
    });

    // 启动动画
    resize();
    initStars();
    animating = true;
    lastTime = performance.now();
    requestAnimationFrame(tick);
  })();
</script>
