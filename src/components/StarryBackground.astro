---
// StarryBackground.astro - 动感多形态星空背景组件 (各种各样的小星星)
---

<div id="starry-container" class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
  <canvas id="starryCanvas" class="w-full h-full block"></canvas>
</div>

<script is:inline>
  (function initStarrySky() {
    var canvas = document.getElementById('starryCanvas');
    if (!canvas) return;

    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    var width = 0;
    var height = 0;
    var animationFrameId;

    // 绚丽星空色彩库 (适合浅色背景的高级质感微光)
    var STAR_COLORS = [
      '#f59e0b', // 暖耀星金
      '#fbbf24', // 璀璨晨曦金
      '#3b82f6', // 湛蓝宝石
      '#60a5fa', // 天空极光蓝
      '#8b5cf6', // 梦幻罗兰紫
      '#a855f7', // 魅惑水晶紫
      '#ec4899', // 樱花粉星
      '#06b6d4', // 碧空青色
      '#10b981', // 极光翠绿
      '#64748b'  // 银灰星钻
    ];

    var STAR_TYPES = [
      'four-point', 'four-point', 'eight-point',
      'five-point', 'circle', 'circle', 'cross'
    ];

    var stars = [];
    var shootingStars = [];
    var mouseSparkles = [];
    var isTabVisible = true;

    // 自适应屏幕分辨率
    function resizeCanvas() {
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      if (ctx) ctx.scale(dpr, dpr);
    }

    // 初始化多样化星星
    function initStars() {
      stars = [];
      // 数量充沛且兼顾轻盈性能 (宽屏约 65-90 颗)
      var starCount = Math.max(50, Math.min(95, Math.floor((width * height) / 14000)));

      for (var i = 0; i < starCount; i++) {
        var type = STAR_TYPES[Math.floor(Math.random() * STAR_TYPES.length)];
        var size = 2 + Math.random() * 4;
        if (type === 'four-point' || type === 'eight-point') {
          size = 4 + Math.random() * 8; // 十字星芒和八角星芒稍大
        } else if (type === 'five-point') {
          size = 3.5 + Math.random() * 5;
        } else if (type === 'cross') {
          size = 3 + Math.random() * 6;
        } else {
          size = 1.5 + Math.random() * 3; // 圆点星尘
        }

        var color = STAR_COLORS[Math.floor(Math.random() * STAR_COLORS.length)];

        stars.push({
          x: Math.random() * width,
          y: Math.random() * height,
          type: type,
          size: size,
          baseAlpha: 0.35 + Math.random() * 0.45,
          alpha: 0.4,
          twinkleSpeed: 0.02 + Math.random() * 0.045,
          twinklePhase: Math.random() * Math.PI * 2,
          vx: (Math.random() - 0.5) * 0.15, // 优雅缓漂
          vy: -0.06 - Math.random() * 0.18, // 缓缓向上漂移
          color: color,
          rotation: Math.random() * Math.PI * 2,
          rotationSpeed: (Math.random() - 0.5) * 0.02
        });
      }
    }

    // 触发随机流星
    function maybeSpawnShootingStar() {
      if (Math.random() < 0.012 && shootingStars.length < 2) {
        shootingStars.push({
          x: Math.random() * width * 0.9,
          y: Math.random() * (height * 0.45),
          len: 90 + Math.random() * 130,
          speed: 10 + Math.random() * 9,
          angle: (Math.PI / 6) + (Math.random() * Math.PI / 12),
          alpha: 0.95,
          width: 1.8 + Math.random() * 1.5,
          active: true
        });
      }
    }

    // 绘制 4 角尖芒钻石星 (✦)
    function drawFourPointStar(c, cx, cy, size, color, alpha, rot) {
      c.save();
      c.translate(cx, cy);
      c.rotate(rot);
      c.fillStyle = color;
      c.globalAlpha = alpha;
      c.shadowColor = color;
      c.shadowBlur = size * 0.7;

      c.beginPath();
      var inner = size * 0.22;
      c.moveTo(0, -size);
      c.quadraticCurveTo(0, -inner, inner, 0);
      c.quadraticCurveTo(0, inner, 0, size);
      c.quadraticCurveTo(0, inner, -inner, 0);
      c.quadraticCurveTo(0, -inner, 0, -size);
      c.closePath();
      c.fill();
      c.restore();
    }

    // 绘制 8 角星辉耀芒 (✧)
    function drawEightPointStar(c, cx, cy, size, color, alpha, rot) {
      c.save();
      c.translate(cx, cy);
      c.rotate(rot);
      c.fillStyle = color;
      c.globalAlpha = alpha;
      c.shadowColor = color;
      c.shadowBlur = size * 0.8;

      var inner = size * 0.18;
      c.beginPath();
      c.moveTo(0, -size);
      c.quadraticCurveTo(0, -inner, inner, 0);
      c.quadraticCurveTo(0, inner, 0, size);
      c.quadraticCurveTo(0, inner, -inner, 0);
      c.quadraticCurveTo(0, -inner, 0, -size);
      c.fill();

      c.rotate(Math.PI / 4);
      var subSize = size * 0.55;
      var subInner = inner * 0.6;
      c.beginPath();
      c.moveTo(0, -subSize);
      c.quadraticCurveTo(0, -subInner, subInner, 0);
      c.quadraticCurveTo(0, subInner, 0, subSize);
      c.quadraticCurveTo(0, subInner, -subInner, 0);
      c.quadraticCurveTo(0, -subInner, 0, -subSize);
      c.fill();

      c.restore();
    }

    // 绘制 5 角几何小星星 (★)
    function drawFivePointStar(c, cx, cy, r, color, alpha, rot) {
      c.save();
      c.translate(cx, cy);
      c.rotate(rot);
      c.fillStyle = color;
      c.globalAlpha = alpha;
      c.shadowColor = color;
      c.shadowBlur = r * 0.6;

      c.beginPath();
      var innerR = r * 0.42;
      for (var i = 0; i < 5; i++) {
        var a1 = (i * 72 - 90) * Math.PI / 180;
        var a2 = ((i * 72 + 36) - 90) * Math.PI / 180;
        var x1 = Math.cos(a1) * r;
        var y1 = Math.sin(a1) * r;
        var x2 = Math.cos(a2) * innerR;
        var y2 = Math.sin(a2) * innerR;
        if (i === 0) c.moveTo(x1, y1);
        else c.lineTo(x1, y1);
        c.lineTo(x2, y2);
      }
      c.closePath();
      c.fill();
      c.restore();
    }

    // 绘制发光圆球星尘 (●)
    function drawCircleStar(c, cx, cy, r, color, alpha) {
      c.save();
      c.fillStyle = color;
      c.globalAlpha = alpha;
      c.shadowColor = color;
      c.shadowBlur = r * 3;
      c.beginPath();
      c.arc(cx, cy, r, 0, Math.PI * 2);
      c.fill();
      c.restore();
    }

    // 绘制极简十字光芒 (+)
    function drawCrossStar(c, cx, cy, size, color, alpha, rot) {
      c.save();
      c.translate(cx, cy);
      c.rotate(rot);
      c.strokeStyle = color;
      c.lineWidth = 1.6;
      c.globalAlpha = alpha;
      c.shadowColor = color;
      c.shadowBlur = size * 0.7;

      c.beginPath();
      c.moveTo(-size, 0);
      c.lineTo(size, 0);
      c.moveTo(0, -size);
      c.lineTo(0, size);
      c.stroke();
      c.restore();
    }

    // 动画主循环
    function animate() {
      if (!isTabVisible) return;

      ctx.clearRect(0, 0, width, height);

      // 1. 渲染各种各样的小星星
      for (var i = 0; i < stars.length; i++) {
        var star = stars[i];

        star.twinklePhase += star.twinkleSpeed;
        var pulse = (Math.sin(star.twinklePhase) + 1) / 2;
        star.alpha = star.baseAlpha * 0.35 + pulse * (star.baseAlpha * 0.95);

        star.x += star.vx;
        star.y += star.vy;
        star.rotation += star.rotationSpeed;

        if (star.y < -20) {
          star.y = height + 20;
          star.x = Math.random() * width;
        }
        if (star.x < -20) star.x = width + 20;
        if (star.x > width + 20) star.x = -20;

        switch (star.type) {
          case 'four-point':
            drawFourPointStar(ctx, star.x, star.y, star.size, star.color, star.alpha, star.rotation);
            break;
          case 'eight-point':
            drawEightPointStar(ctx, star.x, star.y, star.size, star.color, star.alpha, star.rotation);
            break;
          case 'five-point':
            drawFivePointStar(ctx, star.x, star.y, star.size, star.color, star.alpha, star.rotation);
            break;
          case 'circle':
            drawCircleStar(ctx, star.x, star.y, star.size, star.color, star.alpha);
            break;
          case 'cross':
            drawCrossStar(ctx, star.x, star.y, star.size, star.color, star.alpha, star.rotation);
            break;
        }
      }

      // 2. 偶现流星
      maybeSpawnShootingStar();
      for (var j = shootingStars.length - 1; j >= 0; j--) {
        var s = shootingStars[j];
        s.x += Math.cos(s.angle) * s.speed;
        s.y += Math.sin(s.angle) * s.speed;
        s.alpha -= 0.014;

        if (s.alpha > 0) {
          ctx.save();
          var grad = ctx.createLinearGradient(
            s.x, s.y,
            s.x - s.len * Math.cos(s.angle),
            s.y - s.len * Math.sin(s.angle)
          );
          grad.addColorStop(0, 'rgba(255, 255, 255, ' + s.alpha + ')');
          grad.addColorStop(0.25, 'rgba(147, 197, 253, ' + (s.alpha * 0.9) + ')');
          grad.addColorStop(0.65, 'rgba(192, 132, 252, ' + (s.alpha * 0.5) + ')');
          grad.addColorStop(1, 'rgba(147, 197, 253, 0)');

          ctx.strokeStyle = grad;
          ctx.lineWidth = s.width;
          ctx.lineCap = 'round';
          ctx.beginPath();
          ctx.moveTo(s.x, s.y);
          ctx.lineTo(
            s.x - s.len * Math.cos(s.angle),
            s.y - s.len * Math.sin(s.angle)
          );
          ctx.stroke();
          ctx.restore();
        }

        if (s.alpha <= 0 || s.x > width + s.len || s.y > height + s.len) {
          shootingStars.splice(j, 1);
        }
      }

      // 3. 鼠标交互微粒
      for (var k = mouseSparkles.length - 1; k >= 0; k--) {
        var m = mouseSparkles[k];
        m.x += m.vx;
        m.y += m.vy;
        m.alpha -= m.decay;
        m.rotation += 0.05;

        if (m.alpha > 0) {
          drawFourPointStar(ctx, m.x, m.y, m.size, m.color, m.alpha, m.rotation);
        }

        if (m.alpha <= 0) {
          mouseSparkles.splice(k, 1);
        }
      }

      animationFrameId = requestAnimationFrame(animate);
    }

    var lastMouseTime = 0;
    window.addEventListener('mousemove', function(e) {
      var now = performance.now();
      if (now - lastMouseTime > 80 && mouseSparkles.length < 15) {
        lastMouseTime = now;
        var color = STAR_COLORS[Math.floor(Math.random() * STAR_COLORS.length)];
        mouseSparkles.push({
          x: e.clientX,
          y: e.clientY,
          vx: (Math.random() - 0.5) * 1.2,
          vy: (Math.random() - 0.5) * 1.2 - 0.5,
          size: 3 + Math.random() * 4,
          alpha: 0.85,
          decay: 0.025,
          color: color,
          rotation: Math.random() * Math.PI
        });
      }
    }, { passive: true });

    document.addEventListener('visibilitychange', function() {
      isTabVisible = !document.hidden;
      if (isTabVisible) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = requestAnimationFrame(animate);
      }
    });

    var resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() {
        resizeCanvas();
        initStars();
      }, 150);
    });

    resizeCanvas();
    initStars();
    animationFrameId = requestAnimationFrame(animate);
  })();
</script>
