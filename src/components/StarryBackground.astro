---
// StarryBackground.astro - 梦幻极光星河 · 璀璨星宿动态背景 (超高质感艺术星空)
---

<div id="starry-container" class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
  <canvas id="starryCanvas" class="w-full h-full block"></canvas>
</div>

<script is:inline>
  (function initEtherealStarrySky() {
    var canvas = document.getElementById('starryCanvas');
    if (!canvas) return;

    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    var width = 0;
    var height = 0;
    var animationFrameId;
    var isTabVisible = true;

    // 高雅纯美星辉配色方案 (去低质杂色，采用极光蔚蓝、晨曦香槟金、梦幻紫罗兰、钻光纯白)
    var CELESTIAL_PALETTES = [
      { core: '#ffffff', glow: 'rgba(56, 189, 248, 0.75)', halo: 'rgba(56, 189, 248, 0.25)' },  // 冰晶蓝钻
      { core: '#ffffff', glow: 'rgba(251, 191, 36, 0.85)', halo: 'rgba(251, 191, 36, 0.3)' },   // 晨曦金耀
      { core: '#ffffff', glow: 'rgba(168, 85, 247, 0.8)', halo: 'rgba(168, 85, 247, 0.25)' },  // 梦幻紫晶
      { core: '#ffffff', glow: 'rgba(96, 165, 250, 0.8)', halo: 'rgba(96, 165, 250, 0.25)' },  // 浩瀚星海
      { core: '#ffffff', glow: 'rgba(244, 114, 182, 0.75)', halo: 'rgba(244, 114, 182, 0.25)' }  // 霞光星芒
    ];

    var stars = [];
    var shootingStars = [];
    var mouseSparkles = [];
    var nebulaTime = 0;

    // 适应屏幕视口与视网膜高分屏
    function resizeCanvas() {
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      if (ctx) ctx.scale(dpr, dpr);
    }

    // 初始化星宿群
    function initStars() {
      stars = [];
      // 数量适中，既有满天星河的丰盈感，又保持空灵纯净
      var starCount = Math.max(55, Math.min(95, Math.floor((width * height) / 13000)));

      for (var i = 0; i < starCount; i++) {
        var palette = CELESTIAL_PALETTES[Math.floor(Math.random() * CELESTIAL_PALETTES.length)];
        var isSparkle = Math.random() < 0.35; // 35% 为大型十字璀璨星芒
        var isStarlet = Math.random() < 0.25; // 25% 为五角几何小星

        var size = isSparkle ? (5 + Math.random() * 8) : (isStarlet ? (3.5 + Math.random() * 4) : (1.5 + Math.random() * 2.8));

        stars.push({
          x: Math.random() * width,
          y: Math.random() * height,
          isSparkle: isSparkle,
          isStarlet: isStarlet,
          size: size,
          palette: palette,
          baseAlpha: 0.35 + Math.random() * 0.5,
          alpha: 0.4,
          twinkleSpeed: 0.015 + Math.random() * 0.035,
          twinklePhase: Math.random() * Math.PI * 2,
          vx: (Math.random() - 0.5) * 0.2,
          vy: -0.08 - Math.random() * 0.16, // 轻盈缓缓升腾
          rotation: Math.random() * Math.PI * 2,
          rotSpeed: (Math.random() - 0.5) * 0.012
        });
      }
    }

    // 产生流星 (弧光优美)
    function maybeSpawnShootingStar() {
      if (Math.random() < 0.014 && shootingStars.length < 2) {
        shootingStars.push({
          x: Math.random() * width * 0.85,
          y: Math.random() * (height * 0.35),
          len: 100 + Math.random() * 120,
          speed: 12 + Math.random() * 8,
          angle: (Math.PI / 5) + (Math.random() * Math.PI / 15),
          alpha: 1.0,
          width: 2.0 + Math.random() * 1.5,
          color: Math.random() > 0.5 ? '#38bdf8' : '#fbbf24'
        });
      }
    }

    // 绘制高阶璀璨钻石四角星芒 (✦)
    function drawRadiantSparkle(c, cx, cy, size, palette, alpha, rot) {
      c.save();
      c.translate(cx, cy);
      c.rotate(rot);

      // 1. 外层柔和辉光
      var grad = c.createRadialGradient(0, 0, 0, 0, 0, size * 2.2);
      grad.addColorStop(0, palette.glow);
      grad.addColorStop(0.4, palette.halo);
      grad.addColorStop(1, 'rgba(255, 255, 255, 0)');
      c.fillStyle = grad;
      c.beginPath();
      c.arc(0, 0, size * 2.2, 0, Math.PI * 2);
      c.fill();

      // 2. 绘制弧度内凹的四角钻石光芒
      c.fillStyle = palette.glow;
      c.globalAlpha = alpha;
      c.beginPath();
      var inner = size * 0.2;
      c.moveTo(0, -size);
      c.quadraticCurveTo(0, -inner, inner, 0);
      c.quadraticCurveTo(0, inner, 0, size);
      c.quadraticCurveTo(0, inner, -inner, 0);
      c.quadraticCurveTo(0, -inner, 0, -size);
      c.closePath();
      c.fill();

      // 3. 次级斜向微芒 (更加唯美)
      c.rotate(Math.PI / 4);
      c.fillStyle = palette.halo;
      c.beginPath();
      var subSize = size * 0.45;
      var subInner = inner * 0.5;
      c.moveTo(0, -subSize);
      c.quadraticCurveTo(0, -subInner, subInner, 0);
      c.quadraticCurveTo(0, subInner, 0, subSize);
      c.quadraticCurveTo(0, subInner, -subInner, 0);
      c.quadraticCurveTo(0, -subInner, 0, -subSize);
      c.closePath();
      c.fill();

      // 4. 白炽星核 (纯净核心)
      c.fillStyle = '#ffffff';
      c.globalAlpha = Math.min(1, alpha + 0.2);
      c.beginPath();
      c.arc(0, 0, Math.max(1.2, size * 0.16), 0, Math.PI * 2);
      c.fill();

      c.restore();
    }

    // 绘制五角柔光小星 (★)
    function drawFivePointStar(c, cx, cy, r, palette, alpha, rot) {
      c.save();
      c.translate(cx, cy);
      c.rotate(rot);

      c.fillStyle = palette.glow;
      c.globalAlpha = alpha * 0.85;
      c.shadowColor = palette.glow;
      c.shadowBlur = r * 2;

      c.beginPath();
      var innerR = r * 0.42;
      for (var i = 0; i < 5; i++) {
        var a1 = (i * 72 - 90) * Math.PI / 180;
        var a2 = ((i * 72 + 36) - 90) * Math.PI / 180;
        var x1 = Math.cos(a1) * r;
        var y1 = Math.sin(a1) * r;
        var x2 = Math.cos(a2) * innerR;
        var y2 = Math.sin(a2) * innerR;
        if (i === 0) c.moveTo(x1, y1);
        else c.lineTo(x1, y1);
        c.lineTo(x2, y2);
      }
      c.closePath();
      c.fill();

      // 星心纯白微核
      c.fillStyle = '#ffffff';
      c.beginPath();
      c.arc(0, 0, r * 0.25, 0, Math.PI * 2);
      c.fill();

      c.restore();
    }

    // 绘制晶莹微粒圆星 (●)
    function drawCrystalDot(c, cx, cy, r, palette, alpha) {
      c.save();
      var grad = c.createRadialGradient(cx, cy, 0, cx, cy, r * 2.8);
      grad.addColorStop(0, '#ffffff');
      grad.addColorStop(0.3, palette.glow);
      grad.addColorStop(1, 'rgba(255, 255, 255, 0)');

      c.fillStyle = grad;
      c.globalAlpha = alpha;
      c.beginPath();
      c.arc(cx, cy, r * 2.8, 0, Math.PI * 2);
      c.fill();
      c.restore();
    }

    // 绘制动态极光星云浮动光晕 (底蕴高级感)
    function drawAuroraNebulae(c) {
      nebulaTime += 0.003;
      var ox1 = Math.sin(nebulaTime) * 80;
      var oy1 = Math.cos(nebulaTime * 0.8) * 60;
      var ox2 = Math.cos(nebulaTime * 0.7) * 70;
      var oy2 = Math.sin(nebulaTime * 0.9) * 50;

      // 极光青蓝光晕
      var g1 = c.createRadialGradient(width * 0.25 + ox1, height * 0.2 + oy1, 0, width * 0.25 + ox1, height * 0.2 + oy1, Math.min(width, height) * 0.45);
      g1.addColorStop(0, 'rgba(186, 230, 253, 0.45)');
      g1.addColorStop(0.5, 'rgba(224, 242, 254, 0.2)');
      g1.addColorStop(1, 'rgba(255, 255, 255, 0)');
      c.fillStyle = g1;
      c.fillRect(0, 0, width, height);

      // 梦幻罗兰星云
      var g2 = c.createRadialGradient(width * 0.8 + ox2, height * 0.35 + oy2, 0, width * 0.8 + ox2, height * 0.35 + oy2, Math.min(width, height) * 0.42);
      g2.addColorStop(0, 'rgba(233, 213, 255, 0.4)');
      g2.addColorStop(0.5, 'rgba(243, 232, 255, 0.18)');
      g2.addColorStop(1, 'rgba(255, 255, 255, 0)');
      c.fillStyle = g2;
      c.fillRect(0, 0, width, height);

      // 暖金晨光微光 (底部)
      var g3 = c.createRadialGradient(width * 0.5 - ox1 * 0.5, height * 0.85 + oy2 * 0.5, 0, width * 0.5 - ox1 * 0.5, height * 0.85 + oy2 * 0.5, Math.min(width, height) * 0.5);
      g3.addColorStop(0, 'rgba(254, 243, 199, 0.35)');
      g3.addColorStop(0.6, 'rgba(255, 251, 235, 0.12)');
      g3.addColorStop(1, 'rgba(255, 255, 255, 0)');
      c.fillStyle = g3;
      c.fillRect(0, 0, width, height);
    }

    // 动画主循环
    function animate() {
      if (!isTabVisible) return;

      ctx.clearRect(0, 0, width, height);

      // 1. 渲染深邃柔美极光星云
      drawAuroraNebulae(ctx);

      // 2. 星宿星轨连线 (当两颗星星靠近时形成纤细星轨，极其梦幻)
      var maxDist = 95;
      for (var i = 0; i < stars.length; i++) {
        var s1 = stars[i];
        for (var j = i + 1; j < stars.length; j++) {
          var s2 = stars[j];
          var dx = s1.x - s2.x;
          var dy = s1.y - s2.y;
          var dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < maxDist) {
            var lineAlpha = (1 - dist / maxDist) * 0.18 * Math.min(s1.alpha, s2.alpha);
            ctx.strokeStyle = s1.palette.glow;
            ctx.globalAlpha = lineAlpha;
            ctx.lineWidth = 0.85;
            ctx.beginPath();
            ctx.moveTo(s1.x, s1.y);
            ctx.lineTo(s2.x, s2.y);
            ctx.stroke();
          }
        }
      }

      // 3. 渲染各种星体
      for (var k = 0; k < stars.length; k++) {
        var star = stars[k];

        // 自然呼吸明暗计算
        star.twinklePhase += star.twinkleSpeed;
        var pulse = (Math.sin(star.twinklePhase) + 1) / 2;
        star.alpha = star.baseAlpha * 0.3 + pulse * (star.baseAlpha * 0.95);

        // 缓慢浮游与自转
        star.x += star.vx;
        star.y += star.vy;
        star.rotation += star.rotSpeed;

        if (star.y < -30) {
          star.y = height + 30;
          star.x = Math.random() * width;
        }
        if (star.x < -30) star.x = width + 30;
        if (star.x > width + 30) star.x = -30;

        if (star.isSparkle) {
          drawRadiantSparkle(ctx, star.x, star.y, star.size, star.palette, star.alpha, star.rotation);
        } else if (star.isStarlet) {
          drawFivePointStar(ctx, star.x, star.y, star.size, star.palette, star.alpha, star.rotation);
        } else {
          drawCrystalDot(ctx, star.x, star.y, star.size, star.palette, star.alpha);
        }
      }

      // 4. 绚丽流星划空
      maybeSpawnShootingStar();
      for (var m = shootingStars.length - 1; m >= 0; m--) {
        var s = shootingStars[m];
        s.x += Math.cos(s.angle) * s.speed;
        s.y += Math.sin(s.angle) * s.speed;
        s.alpha -= 0.012;

        if (s.alpha > 0) {
          ctx.save();
          var tailX = s.x - s.len * Math.cos(s.angle);
          var tailY = s.y - s.len * Math.sin(s.angle);

          var grad = ctx.createLinearGradient(s.x, s.y, tailX, tailY);
          grad.addColorStop(0, '#ffffff');
          grad.addColorStop(0.2, s.color);
          grad.addColorStop(0.7, 'rgba(192, 132, 252, 0.4)');
          grad.addColorStop(1, 'rgba(255, 255, 255, 0)');

          ctx.strokeStyle = grad;
          ctx.lineWidth = s.width;
          ctx.lineCap = 'round';
          ctx.globalAlpha = s.alpha;
          ctx.beginPath();
          ctx.moveTo(s.x, s.y);
          ctx.lineTo(tailX, tailY);
          ctx.stroke();

          // 流星头部耀斑
          ctx.fillStyle = '#ffffff';
          ctx.shadowColor = s.color;
          ctx.shadowBlur = 10;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.width * 1.2, 0, Math.PI * 2);
          ctx.fill();

          ctx.restore();
        }

        if (s.alpha <= 0 || s.x > width + s.len || s.y > height + s.len) {
          shootingStars.splice(m, 1);
        }
      }

      // 5. 鼠标灵动星尘轨迹
      for (var p = mouseSparkles.length - 1; p >= 0; p--) {
        var ms = mouseSparkles[p];
        ms.x += ms.vx;
        ms.y += ms.vy;
        ms.alpha -= ms.decay;
        ms.rotation += 0.04;

        if (ms.alpha > 0) {
          drawRadiantSparkle(ctx, ms.x, ms.y, ms.size, ms.palette, ms.alpha, ms.rotation);
        }

        if (ms.alpha <= 0) {
          mouseSparkles.splice(p, 1);
        }
      }

      animationFrameId = requestAnimationFrame(animate);
    }

    // 鼠标微粒生成器
    var lastMouseTime = 0;
    window.addEventListener('mousemove', function(e) {
      var now = performance.now();
      if (now - lastMouseTime > 65 && mouseSparkles.length < 18) {
        lastMouseTime = now;
        var palette = CELESTIAL_PALETTES[Math.floor(Math.random() * CELESTIAL_PALETTES.length)];
        mouseSparkles.push({
          x: e.clientX,
          y: e.clientY,
          vx: (Math.random() - 0.5) * 1.5,
          vy: (Math.random() - 0.5) * 1.5 - 0.6,
          size: 3.5 + Math.random() * 4,
          palette: palette,
          alpha: 0.9,
          decay: 0.024,
          rotation: Math.random() * Math.PI
        });
      }
    }, { passive: true });

    document.addEventListener('visibilitychange', function() {
      isTabVisible = !document.hidden;
      if (isTabVisible) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = requestAnimationFrame(animate);
      }
    });

    var resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() {
        resizeCanvas();
        initStars();
      }, 150);
    });

    resizeCanvas();
    initStars();
    animationFrameId = requestAnimationFrame(animate);
  })();
</script>
