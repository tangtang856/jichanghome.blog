---
import type { Airport } from '../data/airports';

interface Props {
  airport: Airport;
}

const { airport } = Astro.props;
---

<div class="my-8">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {airport.plans.map((plan, idx) => {
      const isFeatured = idx === 0;
      return (
        <div class={`rounded-2xl p-6 transition-all flex flex-col justify-between ${
          isFeatured
            ? 'bg-gradient-to-b from-blue-50/60 to-white border-2 border-blue-500 shadow-lg shadow-blue-500/5 relative'
            : 'bg-white border border-slate-200 shadow-sm hover:border-slate-300'
        }`}>
          {isFeatured && (
            <span class="absolute -top-3 left-6 px-3 py-0.5 rounded-full text-[11px] font-black uppercase tracking-wider bg-blue-600 text-white shadow-sm">
              热销推荐 · 最佳性价比
            </span>
          )}

          <div>
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="text-xl font-black text-slate-900">{plan.name}</h3>
                <span class="text-xs text-slate-500">{plan.period} · {plan.deviceLimit}</span>
              </div>
              <div class="text-right">
                <div class="text-3xl font-black text-slate-900 tracking-tight">
                  ¥{plan.price}
                  <span class="text-xs font-normal text-slate-500">/{plan.period}</span>
                </div>
                <div class="text-[11px] font-bold text-emerald-600">
                  折合 ¥{plan.unitPricePerGb}/GB
                </div>
              </div>
            </div>

            <div class="p-3 bg-slate-50 rounded-xl mb-4 text-xs font-semibold text-slate-700 flex items-center justify-between">
              <span>每月可用流量:</span>
              <span class="text-sm font-black text-blue-600">{plan.traffic}</span>
            </div>

            <!-- Features list -->
            <ul class="space-y-2.5 mb-6 text-xs text-slate-600">
              {plan.features.map((f) => (
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>{f}</span>
                </li>
              ))}
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>峰值接入端口带宽：{plan.bandwidth}</span>
              </li>
            </ul>
          </div>

          <a
            href={airport.affUrl}
            target="_blank"
            rel="noopener nofollow"
            class={`w-full py-3 rounded-xl text-center text-xs font-bold transition-all shadow-sm ${
              isFeatured
                ? 'bg-blue-600 hover:bg-blue-700 text-white shadow-blue-500/20 hover:shadow-md'
                : 'bg-slate-100 hover:bg-slate-200 text-slate-800'
            }`}
          >
            立即订阅 {plan.name} &rarr;
          </a>
        </div>
      );
    })}
  </div>
</div>
