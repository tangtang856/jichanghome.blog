---
import type { Airport } from '../data/airports';
import { AIRPORTS } from '../data/airports';

interface Props {
  currentAirport: Airport;
}

const { currentAirport } = Astro.props;

const currentIndex = AIRPORTS.findIndex(a => a.id === currentAirport.id);
const prevIndex = (currentIndex - 1 + AIRPORTS.length) % AIRPORTS.length;
const nextIndex = (currentIndex + 1) % AIRPORTS.length;
const prevAirport = AIRPORTS[prevIndex];
const nextAirport = AIRPORTS[nextIndex];
---

<aside class="sticky top-20 space-y-4">
  <!-- Next Airport Feature Card -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow overflow-hidden">
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 px-4 py-3 border-b border-blue-100 flex items-center justify-between">
      <span class="inline-flex items-center gap-1.5 text-xs font-extrabold text-blue-700">
        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <polygon points="5 4 15 12 5 20 5 4"></polygon>
          <line x1="19" y1="5" x2="19" y2="19"></line>
        </svg>
        下一个机场评测
      </span>
      <span class="px-2 py-0.5 rounded-full text-[11px] font-black bg-blue-600 text-white shadow-sm">
        #{nextAirport.rank}
      </span>
    </div>

    <div class="p-4 space-y-3">
      <div>
        <h3 class="text-lg font-black text-slate-900 leading-snug hover:text-blue-600 transition-colors">
          <a href={`/airport/${nextAirport.slug}/`}>{nextAirport.name}</a>
        </h3>
        <p class="text-xs text-slate-500 line-clamp-2 mt-1 leading-relaxed">
          {nextAirport.tagline}
        </p>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="grid grid-cols-2 gap-2 bg-slate-50 p-2.5 rounded-xl border border-slate-100 text-xs">
        <div>
          <span class="block text-[11px] text-slate-400">起步价格</span>
          <span class="font-extrabold text-red-600 text-sm">
            ¥{nextAirport.startingPrice}
            <small class="text-[10px] text-slate-500 font-normal">/月</small>
          </span>
        </div>
        <div>
          <span class="block text-[11px] text-slate-400">每月配额</span>
          <span class="font-bold text-slate-800 text-sm">{nextAirport.plans[0]?.traffic || '大流量'}</span>
        </div>
        <div>
          <span class="block text-[11px] text-slate-400">线路架构</span>
          <span class="font-semibold text-slate-700 truncate block">{nextAirport.lineType}</span>
        </div>
        <div>
          <span class="block text-[11px] text-slate-400">综合评分</span>
          <span class="font-bold text-blue-600">⭐ {nextAirport.scoreOverall}</span>
        </div>
      </div>

      <!-- Jump Button -->
      <a
        href={`/airport/${nextAirport.slug}/`}
        class="w-full flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-xs font-bold shadow-md shadow-blue-500/20 hover:from-blue-700 hover:to-indigo-700 hover:shadow-lg transition-all group"
      >
        <span>跳转到下一个机场</span>
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>

      <!-- Previous Airport Link -->
      <div class="text-center pt-1 border-t border-slate-100">
        <a href={`/airport/${prevAirport.slug}/`} class="text-[11px] text-slate-400 hover:text-blue-600 transition-colors">
          &larr; 上一个：#{prevAirport.rank} {prevAirport.name}
        </a>
      </div>
    </div>

    <!-- 14 Brands Quick Switcher -->
    <div class="bg-slate-50/80 px-4 py-3 border-t border-slate-200">
      <div class="flex items-center justify-between text-xs font-bold text-slate-600 mb-2">
        <span>14大品牌快速切换</span>
        <span class="text-[10px] px-1.5 py-0.5 bg-slate-200 text-slate-600 rounded-full font-semibold">{AIRPORTS.length} 家</span>
      </div>
      <div class="space-y-1 max-h-56 overflow-y-auto pr-1 custom-scrollbar">
        {AIRPORTS.map((a) => {
          const isActive = a.id === currentAirport.id;
          return (
            <a
              href={`/airport/${a.slug}/`}
              class={`flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs transition-colors ${
                isActive
                  ? 'bg-blue-100/70 border border-blue-200 font-bold text-blue-700'
                  : 'hover:bg-white hover:text-blue-600 text-slate-700'
              }`}
            >
              <span class={`text-[10px] font-mono min-w-[1.2rem] ${isActive ? 'text-blue-600 font-bold' : 'text-slate-400'}`}>
                #{a.rank}
              </span>
              <span class="flex-1 truncate">{a.name}</span>
              {isActive ? (
                <span class="text-[9px] px-1.5 py-0.2 rounded bg-blue-600 text-white font-bold">当前</span>
              ) : (
                <span class="text-[11px] text-slate-400 font-mono">¥{a.startingPrice}</span>
              )}
            </a>
          );
        })}
      </div>
    </div>
  </div>
</aside>
