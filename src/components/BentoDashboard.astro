---
import type { Airport } from '../data/airports';

interface Props {
  airport: Airport;
}

const { airport } = Astro.props;

const mainPlan = airport.plans[0];
const topBenchmark = airport.benchmarks[0];
---

<div class="my-8">
  <div class="flex items-center gap-2 mb-4">
    <span class="w-2.5 h-6 rounded-full bg-blue-600"></span>
    <h2 class="text-xl font-black text-slate-900 tracking-tight !my-0 !py-0 !border-b-0">
      编辑部核心评测驾驶舱 · 极速结论 (Bento Dashboard)
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4">
    <!-- Tile 1: 核心资费与单GB性价比 (Wide card) -->
    <div class="md:col-span-2 bg-gradient-to-br from-white to-slate-50 rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden flex flex-col justify-between">
      <div class="absolute -right-6 -bottom-6 w-32 h-32 bg-blue-500/5 rounded-full pointer-events-none"></div>
      
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
            💰 官方实时资费标准
          </span>
          <span class="text-xs font-semibold text-slate-400">核验于 {airport.lastVerified}</span>
        </div>

        <div class="flex items-baseline gap-3 my-2">
          <span class="text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
            ¥{airport.startingPrice}
          </span>
          <span class="text-sm text-slate-500 font-medium">
            {airport.currency} 起步 / {mainPlan.traffic} 流量
          </span>
          <span class="ml-auto px-2.5 py-1 rounded-lg text-xs font-extrabold bg-emerald-50 text-emerald-700 border border-emerald-200">
            ¥{mainPlan.unitPricePerGb}/GB
          </span>
        </div>

        <p class="text-xs text-slate-600 leading-relaxed mt-2">
          {airport.theme.editorialVerdict}
        </p>
      </div>

      <!-- Coupon & CTA Action -->
      <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
        {airport.coupon ? (
          <div class="flex items-center gap-2 text-xs bg-rose-50 text-rose-700 px-3 py-1.5 rounded-xl border border-dashed border-rose-300">
            <span>🎁 优惠码:</span>
            <code class="font-mono font-bold text-rose-800 bg-white px-1.5 py-0.5 rounded border border-rose-200">{airport.coupon}</code>
            <span class="text-[10px] text-rose-500">（结算立减）</span>
          </div>
        ) : (
          <span class="text-xs text-slate-400">官方透明月付制，支持按需续订</span>
        )}

        <a
          href={airport.affUrl}
          target="_blank"
          rel="noopener nofollow"
          class="inline-flex items-center gap-1 px-4 py-2 rounded-xl text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-sm hover:shadow transition-all ml-auto"
        >
          直达官网订购
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
      </div>
    </div>

    <!-- Tile 2: 晚高峰实测实验室看板 -->
    <div class="bg-gradient-to-br from-slate-900 to-indigo-950 text-white rounded-2xl p-5 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold text-indigo-300 flex items-center gap-1">
            ⚡ 晚高峰实测性能
          </span>
          <span class="text-[10px] px-1.5 py-0.5 bg-indigo-500/30 text-indigo-200 rounded font-mono">
            {topBenchmark.status}
          </span>
        </div>

        <div class="space-y-2.5 my-3">
          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-400">核心节点延迟 (Ping)</span>
              <span class="font-bold text-indigo-200 font-mono">{topBenchmark.ping}</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-1.5">
              <div class="bg-emerald-400 h-1.5 rounded-full" style="width: 88%"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-400">晚高峰测速带宽</span>
              <span class="font-bold text-indigo-200 font-mono">{topBenchmark.dl}</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-1.5">
              <div class="bg-blue-400 h-1.5 rounded-full" style="width: 92%"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="text-[11px] text-slate-300 bg-white/10 px-2.5 py-1.5 rounded-lg flex items-center justify-between">
        <span>YouTube 4K体验:</span>
        <span class="font-semibold text-emerald-300">{topBenchmark.yt}</span>
      </div>
    </div>

    <!-- Tile 3: 解锁能力矩阵与评分画像 -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold text-slate-700">🎯 解锁能力生态</span>
          <span class="text-xs font-black text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full">
            {airport.scoreOverall} / 10
          </span>
        </div>

        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs py-1 border-b border-slate-100">
            <span class="text-slate-500">ChatGPT / Claude</span>
            <span class="inline-flex items-center gap-1 text-emerald-600 font-bold text-[11px]">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              完美解锁
            </span>
          </div>
          <div class="flex items-center justify-between text-xs py-1 border-b border-slate-100">
            <span class="text-slate-500">Netflix 原生4K</span>
            <span class="inline-flex items-center gap-1 text-emerald-600 font-bold text-[11px]">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              非自制剧全开
            </span>
          </div>
          <div class="flex items-center justify-between text-xs py-1">
            <span class="text-slate-500">Disney+ / YouTube</span>
            <span class="inline-flex items-center gap-1 text-emerald-600 font-bold text-[11px]">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              即开秒播
            </span>
          </div>
        </div>
      </div>

      <div class="mt-3 text-[11px] text-slate-500 bg-slate-50 p-2 rounded-lg">
        <strong>主要定位：</strong> {airport.theme.scenarioFocus}
      </div>
    </div>
  </div>
</div>
