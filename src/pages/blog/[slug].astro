---
import BaseLayout from '../../layouts/BaseLayout.astro';
// @ts-ignore
import ALL_ARTICLES from '../../data/articles.js';
// @ts-ignore
import GUIDES from '../../data/guides.js';
import { AIRPORTS } from '../../data/airports';
import NextArticleWidget from '../../components/NextArticleWidget.astro';
import ArticleBottomNav from '../../components/ArticleBottomNav.astro';

export function getStaticPaths() {
  const total = ALL_ARTICLES.length;
  return ALL_ARTICLES.map((article: any, index: number) => {
    const prevIndex = (index - 1 + total) % total;
    const nextIndex = (index + 1) % total;
    const upcoming = [];
    for (let i = 1; i <= 5; i++) {
      upcoming.push(ALL_ARTICLES[(index + i) % total]);
    }

    return {
      params: { slug: article.slug },
      props: {
        article,
        prevArticle: ALL_ARTICLES[prevIndex],
        nextArticle: ALL_ARTICLES[nextIndex],
        currentIndex: index,
        totalArticles: total,
        upcomingArticles: upcoming
      }
    };
  });
}

interface Props {
  article: any;
  prevArticle: any;
  nextArticle: any;
  currentIndex: number;
  totalArticles: number;
  upcomingArticles: any[];
}

const {
  article,
  prevArticle,
  nextArticle,
  currentIndex,
  totalArticles,
  upcomingArticles
} = Astro.props;

// Top 3 airports for sidebar recommendation
const topAirports = AIRPORTS.slice(0, 3);
// Top 4 guides for client cross-linking
const topGuides = (GUIDES || []).slice(0, 4);

// Related articles in the same category
const relatedArticles = ALL_ARTICLES
  .filter((a: any) => a.slug !== article.slug && a.category === article.category)
  .slice(0, 4);

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": article.h1,
  "description": article.desc,
  "datePublished": article.date,
  "author": {
    "@type": "Organization",
    "name": "机场之家编辑部"
  },
  "publisher": {
    "@type": "Organization",
    "name": "机场之家",
    "url": "https://jichanghome.blog/"
  }
};
---

<BaseLayout
  title={article.title}
  description={article.desc}
  canonicalPath={`blog/${article.slug}/`}
  currentNav="blog"
  schema={schema}
>
  <!-- Header -->
  <section class="bg-white border-b border-slate-200 py-8 lg:py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-4" aria-label="面包屑导航">
        <a href="/" class="hover:text-blue-600 transition-colors">首页</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-blue-600 transition-colors">选型指南</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold">{article.category}</span>
      </nav>

      <div class="max-w-4xl space-y-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
            {article.category}
          </span>
          <span class="px-2.5 py-0.5 rounded-md text-xs font-mono font-semibold bg-slate-100 text-slate-700">
            连载第 {currentIndex + 1} / {totalArticles} 篇
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight leading-tight">
          {article.h1}
        </h1>

        <div class="flex flex-wrap items-center gap-4 text-xs text-slate-500 pt-1">
          <span>发布时间：{article.date}</span>
          <span>•</span>
          <span>预计阅读：{article.readTime}</span>
          <span>•</span>
          <span>来源：机场之家编辑部</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2-Column Content Layout -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Article Body (8 cols) -->
      <article class="lg:col-span-8 bg-white p-6 sm:p-10 rounded-2xl border border-slate-200/80 shadow-sm min-w-0">
        <!-- Lead summary box -->
        <div class="p-4 sm:p-5 rounded-xl bg-blue-50/50 border border-blue-100 text-xs sm:text-sm text-slate-700 leading-relaxed mb-8">
          <strong>摘要导读：</strong> {article.desc}
        </div>

        <div class="article-prose" set:html={article.content} />

        <!-- Article Footer CTA Recommendation -->
        <div class="mt-12 pt-8 border-t border-slate-200">
          <div class="p-6 rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-700 text-white text-center shadow-lg">
            <h3 class="text-lg font-black mb-2">需要高品质稳定网络节点？</h3>
            <p class="text-xs text-blue-100 mb-4 max-w-md mx-auto">
              查看机场之家 2026 综合排行榜，核验晚高峰不卡顿的优质内网专线服务商。
            </p>
            <div class="flex flex-wrap items-center justify-center gap-3">
              <a href="/ranking/" class="px-5 py-2.5 rounded-xl text-xs font-bold bg-white text-blue-700 hover:bg-blue-50 shadow-sm">
                查看全站排行榜 &rarr;
              </a>
              <a href="/compare/" class="px-5 py-2.5 rounded-xl text-xs font-bold bg-blue-500 text-white hover:bg-blue-400">
                横向在线对比工具
              </a>
            </div>
          </div>
        </div>

        <!-- Article Bottom Navigation & Interlinking Hub (上一篇 / 下一篇 / 全站内链) -->
        <ArticleBottomNav
          nextArticle={nextArticle}
          prevArticle={prevArticle}
          currentIndex={currentIndex}
          totalCount={totalArticles}
          basePath="blog"
          typeLabel="文章"
        />
      </article>

      <!-- Sidebar (4 cols) -->
      <aside class="lg:col-span-4 space-y-6">
        <!-- 1. Next Article Feature Sticky Widget -->
        <div class="sticky top-20 space-y-6">
          <NextArticleWidget
            nextArticle={nextArticle}
            prevArticle={prevArticle}
            currentIndex={currentIndex}
            totalCount={totalArticles}
            basePath="blog"
            typeLabel="文章"
            upcomingList={upcomingArticles}
          />

          <!-- 2. Recommended Brands Widget -->
          <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">
              🔥 2026精选专线机场推荐
            </h3>
            <div class="space-y-3">
              {topAirports.map((a) => (
                <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 hover:border-blue-300 transition-colors flex items-center justify-between gap-3">
                  <div class="min-w-0">
                    <div class="flex items-center gap-1.5">
                      <span class="text-[10px] font-black px-1.5 py-0.2 rounded bg-blue-600 text-white">#{a.rank}</span>
                      <h4 class="text-xs font-black text-slate-900 truncate hover:text-blue-600">
                        <a href={`/airport/${a.slug}/`}>{a.name}</a>
                      </h4>
                    </div>
                    <span class="text-[11px] text-slate-400 block mt-0.5">{a.lineType} · ¥{a.startingPrice}/月</span>
                  </div>
                  <a
                    href={`/airport/${a.slug}/`}
                    class="px-2.5 py-1.5 rounded-lg text-xs font-bold bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white transition-colors flex-shrink-0"
                  >
                    评测
                  </a>
                </div>
              ))}
            </div>
          </div>

          <!-- 3. Client Tutorials Internal Links -->
          <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">
                🛠️ 常用客户端实操教程
              </h3>
              <a href="/guides/" class="text-[11px] font-bold text-blue-600 hover:underline">全部30篇 &rarr;</a>
            </div>
            <ul class="space-y-2.5 text-xs">
              {topGuides.map((g: any) => (
                <li>
                  <a href={`/guides/${g.slug}/`} class="text-slate-700 hover:text-blue-600 font-medium line-clamp-1 flex items-center gap-1.5">
                    <span class="text-blue-500">•</span>
                    <span>{g.h1}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- 4. Related Articles In Same Category -->
          {relatedArticles.length > 0 && (
            <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
              <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">
                📚 同类专题深度文章
              </h3>
              <ul class="space-y-3">
                {relatedArticles.map((ra: any) => (
                  <li>
                    <a href={`/blog/${ra.slug}/`} class="text-xs font-bold text-slate-800 hover:text-blue-600 line-clamp-2 leading-snug">
                      {ra.h1}
                    </a>
                    <span class="text-[10px] text-slate-400 mt-0.5 block">{ra.date}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </aside>

    </div>
  </div>
</BaseLayout>
