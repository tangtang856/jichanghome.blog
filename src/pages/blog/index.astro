---
import BaseLayout from '../../layouts/BaseLayout.astro';
// @ts-ignore
import ALL_ARTICLES from '../../data/articles.js';

const title = "科学上网选型指南与深度技术博客 | 100篇精品原创文章 - 机场之家";
const description = "精选100篇涵盖机场选型、IPLC专线原理解析、抗封锁协议演进（VLESS/Reality/Hysteria 2）、流媒体解锁、AI风控防封及网络安全审计的深度技术文章。";
const keywords = "机场选型, 梯子推荐, 翻墙原理, IPLC专线, VLESS, 流媒体解锁, ChatGPT防封";
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath="blog/"
  currentNav="blog"
>
  <section class="bg-white border-b border-slate-200 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 mb-4">
        全站 100 篇原创深度科普与选型技术文章
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        科学上网与机场选型深度指南
      </h1>
      <p class="text-sm sm:text-base text-slate-600 mt-4 leading-relaxed">
        涵盖基础选型、专线底层架构、协议抗封锁演进、流媒体4K解锁、AI风控防封与翻墙安全审计等10大核心主题。
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {ALL_ARTICLES.map((article: any) => (
        <article class="bg-white rounded-2xl border border-slate-200 p-6 hover:border-blue-400 hover:shadow-lg transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
              <span class="px-2.5 py-0.5 rounded-full font-bold bg-blue-50 text-blue-700 border border-blue-100">
                {article.category}
              </span>
              <span>{article.readTime}</span>
            </div>

            <h2 class="text-base font-black text-slate-900 group-hover:text-blue-600 transition-colors leading-snug mb-2">
              <a href={`/blog/${article.slug}/`}>{article.h1}</a>
            </h2>

            <p class="text-xs text-slate-500 line-clamp-3 leading-relaxed mb-4">
              {article.desc}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-slate-400">{article.date}</span>
            <a href={`/blog/${article.slug}/`} class="font-bold text-blue-600 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
              阅读全文 &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
