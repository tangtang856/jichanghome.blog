---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AIRPORTS } from '../data/airports';
// @ts-ignore
import GUIDES from '../data/guides.js';
// @ts-ignore
import ALL_ARTICLES from '../data/articles.js';

const title = "2026专业中文机场推荐与梯子节点导航指南 | 靠谱稳定VPN评测 - 机场之家";
const description = "机场之家汇集2026年最新经过真实晚高峰测速的优质中文机场推荐、梯子推荐与VPN节点选型指南。基于自费抽样核验，客观呈现各品牌真实价格、流量配额、单GB成本与AI/4K流媒体解锁表现。";
const keywords = "机场推荐, 机场节点, 性价比机场, 梯子推荐, vpn, vpn机场, vpn节点, vpn推荐";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "机场之家",
  "url": "https://jichanghome.blog/",
  "description": description,
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://jichanghome.blog/compare/",
    "query-input": "required name=search_term_string"
  }
};

const topThree = AIRPORTS.slice(0, 3);
const recentGuides = GUIDES.slice(0, 4);
const recentArticles = ALL_ARTICLES.slice(0, 6);
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath=""
  currentNav="home"
  schema={schema}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-white/70 via-blue-50/20 to-slate-50/70 border-b border-slate-200 py-16 lg:py-24 relative overflow-hidden backdrop-blur-[2px]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
        <span>2026年度晚高峰实机测速基准已全量核验</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight max-w-4xl mx-auto">
        2026年稳定优质<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">机场推荐</span>与网络节点选购指南
      </h1>

      <p class="text-base sm:text-lg text-slate-600 mt-6 max-w-2xl mx-auto leading-relaxed">
        拒绝虚标假专线与跑路风险。为中文用户提供客观透明的<strong>梯子推荐</strong>、<strong>性价比机场</strong>对比与<strong>VPN节点</strong>测速数据，助您告别断连与高延迟。
      </p>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3.5 mt-8">
        <a
          href="/ranking/"
          class="px-6 py-3 rounded-xl text-xs sm:text-sm font-extrabold uppercase tracking-wider bg-blue-600 hover:bg-blue-700 text-white shadow-lg shadow-blue-500/25 hover:shadow-xl transition-all active:scale-95"
        >
          查看综合排行榜 &rarr;
        </a>
        <a
          href="/compare/"
          class="px-6 py-3 rounded-xl text-xs sm:text-sm font-extrabold bg-white hover:bg-slate-50 text-slate-800 border border-slate-300 shadow-sm hover:shadow transition-all"
        >
          在线横向对比工具
        </a>
        <a
          href="/recommend/budget/"
          class="px-5 py-3 rounded-xl text-xs sm:text-sm font-bold bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200 transition-colors"
        >
          💰 学生党低预算专区
        </a>
      </div>

      <!-- Quick Stats Strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto mt-12 pt-8 border-t border-slate-200/80 text-center">
        <div>
          <span class="block text-2xl font-black text-slate-900">14 家</span>
          <span class="text-xs text-slate-500">已核验品牌独立评测</span>
        </div>
        <div>
          <span class="block text-2xl font-black text-emerald-600">¥0.04起</span>
          <span class="text-xs text-slate-500">最低单GB折算成本</span>
        </div>
        <div>
          <span class="block text-2xl font-black text-blue-600">100 篇</span>
          <span class="text-xs text-slate-500">选型避坑与协议深度指南</span>
        </div>
        <div>
          <span class="block text-2xl font-black text-indigo-600">30 篇</span>
          <span class="text-xs text-slate-500">全平台客户端实操教程</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Answers Bento Strip -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 relative z-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-white p-5 rounded-2xl border border-slate-200/90 shadow-sm flex items-start gap-3">
        <span class="text-2xl">🌱</span>
        <div>
          <h3 class="text-sm font-black text-slate-900">新手应该如何选择？</h3>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">
            优先选择月付10~20元内、支持一键导入订阅的专线品牌，切莫在不了解连通率的情况下贪便宜盲目年付。
          </p>
        </div>
      </div>
      <div class="bg-white p-5 rounded-2xl border border-slate-200/90 shadow-sm flex items-start gap-3">
        <span class="text-2xl">⚖️</span>
        <div>
          <h3 class="text-sm font-black text-slate-900">如何判断套餐是否划算？</h3>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">
            认准真实“每GB成本 = 套餐价格 / 实际可用流量”，警惕标称大流量却暗藏3x~5x高倍率的扣费套路。
          </p>
        </div>
      </div>
      <div class="bg-white p-5 rounded-2xl border border-slate-200/90 shadow-sm flex items-start gap-3">
        <span class="text-2xl">🛡️</span>
        <div>
          <h3 class="text-sm font-black text-slate-900">购买前应该检查什么？</h3>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">
            检查晚高峰（20:00~23:00）的实测丢包率是否低于0.5%，以及节点落地是否为原生IP以支持ChatGPT与4K解锁。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Top 3 Podium Showcase -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-blue-600 block mb-1">权威实测精选</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 !my-0">2026年综合排名前三甲机场领跑者</h2>
      </div>
      <a href="/ranking/" class="text-xs font-bold text-blue-600 hover:underline">
        查看全网14家完整排行榜 &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {topThree.map((a, idx) => (
        <div class={`rounded-3xl p-6 border transition-all flex flex-col justify-between ${
          idx === 0
            ? 'bg-gradient-to-b from-blue-50/70 to-white border-blue-500 shadow-xl shadow-blue-500/10 relative'
            : 'bg-white border-slate-200 shadow-sm hover:shadow-md hover:border-slate-300'
        }`}>
          {idx === 0 && (
            <span class="absolute -top-3 left-6 px-3 py-0.5 rounded-full text-[11px] font-black uppercase tracking-wider bg-blue-600 text-white shadow-sm">
              🏆 综合实力第一名
            </span>
          )}

          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="w-8 h-8 rounded-xl bg-slate-900 text-white flex items-center justify-center font-black text-xs">
                #{a.rank}
              </span>
              <span class="text-xs font-extrabold text-blue-600">
                ⭐ {a.scoreOverall} / 10
              </span>
            </div>

            <h3 class="text-xl font-black text-slate-900 hover:text-blue-600 transition-colors">
              <a href={`/airport/${a.slug}/`}>{a.name}</a>
            </h3>
            <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-700 mt-1 mb-3">
              {a.lineType}
            </span>

            <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed mb-4">
              {a.tagline}
            </p>

            <div class="bg-slate-50 rounded-xl p-3 mb-6 flex items-center justify-between">
              <div>
                <span class="text-[10px] text-slate-400 block">起步月资费</span>
                <span class="text-lg font-black text-red-600">¥{a.startingPrice} <small class="text-xs text-slate-400 font-normal">/月</small></span>
              </div>
              <div class="text-right">
                <span class="text-[10px] text-slate-400 block">可用流量与单GB</span>
                <span class="text-xs font-bold text-emerald-600">{a.plans[0].traffic} (¥{a.plans[0].unitPricePerGb}/GB)</span>
              </div>
            </div>
          </div>

          <div class="space-y-2">
            <a
              href={`/airport/${a.slug}/`}
              class="block w-full py-2.5 rounded-xl text-center text-xs font-bold bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white transition-colors"
            >
              独立评测详情 &rarr;
            </a>
            <a
              href={a.affUrl}
              target="_blank"
              rel="noopener nofollow"
              class="block w-full py-2 rounded-xl text-center text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700"
            >
              直达官网 ↗
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Complete 14 Brand Directory Grid -->
  <section class="bg-slate-100/60 border-y border-slate-200 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight !my-0">
          全站14大已核验机场品牌全景目录
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-2">
          涵盖平价、电竞、大流量、商务专线等多元需求，每一家均附有独立评测与晚高峰测速报告。
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {AIRPORTS.map((a) => (
          <div class="bg-white rounded-2xl p-5 border border-slate-200 hover:border-blue-400 hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-[11px] font-mono font-bold text-slate-400">#{a.rank}</span>
                <span class="text-xs font-black text-red-600">¥{a.startingPrice}/月</span>
              </div>
              <h3 class="text-sm font-black text-slate-900 hover:text-blue-600">
                <a href={`/airport/${a.slug}/`}>{a.name}</a>
              </h3>
              <p class="text-[11px] text-slate-400 mt-1 line-clamp-1">{a.lineType}</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
              <span class="text-[10px] text-emerald-600 font-bold">¥{a.plans[0].unitPricePerGb}/GB</span>
              <a href={`/airport/${a.slug}/`} class="text-xs font-bold text-blue-600 hover:underline">
                评测 &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Guides & Blog Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Left: Tutorials -->
      <div>
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-black text-slate-900 !my-0">全平台客户端使用教程</h2>
          <a href="/guides/" class="text-xs font-bold text-blue-600 hover:underline">查看全部30篇教程 &rarr;</a>
        </div>
        <div class="space-y-3">
          {recentGuides.map((g: any) => (
            <a
              href={`/guides/${g.slug}/`}
              class="block p-4 rounded-xl bg-white border border-slate-200 hover:border-emerald-400 hover:shadow-sm transition-all"
            >
              <div class="flex items-center justify-between text-[11px] text-slate-400 mb-1">
                <span class="px-2 py-0.2 rounded bg-emerald-50 text-emerald-700 font-bold">{g.category}</span>
                <span>{g.readTime}</span>
              </div>
              <h3 class="text-xs font-bold text-slate-900 line-clamp-1 hover:text-emerald-600">{g.h1}</h3>
            </a>
          ))}
        </div>
      </div>

      <!-- Right: Deep Articles -->
      <div>
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-black text-slate-900 !my-0">选型指南与技术科普</h2>
          <a href="/blog/" class="text-xs font-bold text-blue-600 hover:underline">查看全部100篇文章 &rarr;</a>
        </div>
        <div class="space-y-3">
          {recentArticles.map((a: any) => (
            <a
              href={`/blog/${a.slug}/`}
              class="block p-4 rounded-xl bg-white border border-slate-200 hover:border-blue-400 hover:shadow-sm transition-all"
            >
              <div class="flex items-center justify-between text-[11px] text-slate-400 mb-1">
                <span class="px-2 py-0.2 rounded bg-blue-50 text-blue-700 font-bold">{a.category}</span>
                <span>{a.date}</span>
              </div>
              <h3 class="text-xs font-bold text-slate-900 line-clamp-1 hover:text-blue-600">{a.h1}</h3>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Comprehensive SEO FAQ -->
  <section class="bg-white border-t border-slate-200 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="text-xs font-bold text-blue-600 uppercase tracking-wider">Bing SEO 重点问答</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mt-1 !my-0">
          关于机场推荐、梯子与VPN节点的常见疑问
        </h2>
      </div>

      <div class="space-y-4">
        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
          <h3 class="text-sm font-bold text-slate-900 !mt-0 !mb-2 flex items-center gap-2">
            <span class="text-blue-600 font-black">Q:</span>
            网络机场、梯子和传统商业VPN（如ExpressVPN）有什么本质区别？
          </h3>
          <p class="text-xs text-slate-600 !mb-0 leading-relaxed">
            传统商业VPN使用OpenVPN或WireGuard等通用协议，特征明显，在国内极易遭受防火长城的主动探测阻断；而现代“机场”采用专为抗封锁设计的Shadowsocks、VLESS、Trojan等协议，配合国内BGP入口与IPLC/IEPL物理内网专线中转，晚高峰延迟低且几乎不断连。
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
          <h3 class="text-sm font-bold text-slate-900 !mt-0 !mb-2 flex items-center gap-2">
            <span class="text-blue-600 font-black">Q:</span>
            为什么买机场千万不要冲动选择年付？
          </h3>
          <p class="text-xs text-slate-600 !mb-0 leading-relaxed">
            科学上网行业线路成本随骨干网带宽价格波动，且极易面临同行DDoS攻击与不可抗力。部分不良商家以“极低年付折算”诱导用户一次性预付一年甚至两年费用后迅速跑路。无论宣传多么天花乱坠，始终坚持按月付试用才是最安全的防坑策略。
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
          <h3 class="text-sm font-bold text-slate-900 !mt-0 !mb-2 flex items-center gap-2">
            <span class="text-blue-600 font-black">Q:</span>
            什么是纯内网 IPLC 专线？它真的比公网中转更好吗？
          </h3>
          <p class="text-xs text-slate-600 !mb-0 leading-relaxed">
            IPLC是点对点的国际私有物理光纤专线。数据在国内入口机房进入后直接走物理内网直达香港或日本对端，完全不过公网国际出口，不受晚高峰拥堵和GFW检测影响，丢包率几乎为0%，是目前稳定性最高的科学上网解决方案。
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
