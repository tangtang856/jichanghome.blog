---
import BaseLayout from '../../layouts/BaseLayout.astro';
// @ts-ignore
import GUIDES from '../../data/guides.js';

const title = "科学上网全平台客户端配置教程中心 | 30篇图文保姆级指南 - 机场之家";
const description = "收录Windows、Android、iOS、macOS、Linux与软路由全平台科学上网客户端（Clash Verge、Sing-box、Shadowrocket、Surge、Loon）安装、订阅导入与TUN模式配置教程。";
const keywords = "Clash教程, Sing-box配置, 小火箭Shadowrocket, Surge教程, 翻墙教程, 梯子配置, 节点导入";
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath="guides/"
  currentNav="guides"
>
  <section class="bg-white border-b border-slate-200 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 mb-4">
        30篇全平台客户端图文教程库
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        科学上网全平台客户端保姆级教程
      </h1>
      <p class="text-sm sm:text-base text-slate-600 mt-4 leading-relaxed">
        涵盖Windows、macOS、Android、iOS、Linux及软路由设备。手把手教学节点订阅导入、TUN全局虚拟网卡开启、规则分流编写与网络排障自检。
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {GUIDES.map((guide: any) => (
        <div class="bg-white rounded-2xl border border-slate-200 p-6 hover:border-emerald-400 hover:shadow-lg transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
              <span class="px-2.5 py-0.5 rounded-full font-bold bg-emerald-50 text-emerald-700 border border-emerald-100">
                {guide.category}
              </span>
              <span>{guide.readTime}</span>
            </div>

            <h2 class="text-base font-black text-slate-900 group-hover:text-emerald-600 transition-colors leading-snug mb-2">
              <a href={`/guides/${guide.slug}/`}>{guide.h1}</a>
            </h2>

            <p class="text-xs text-slate-500 line-clamp-3 leading-relaxed mb-4">
              {guide.desc}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-slate-400">{guide.date}</span>
            <a href={`/guides/${guide.slug}/`} class="font-bold text-emerald-600 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
              查看教程 &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
