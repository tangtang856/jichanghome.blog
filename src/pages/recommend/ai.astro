---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AIRPORTS } from '../../data/airports';

const title = "ChatGPT与Claude专用原生IP机场节点推荐 | 解锁AI服务避坑 - 机场之家";
const description = "专为OpenAI ChatGPT、Claude 3.5 Sonnet、Google Gemini及Midjourney打造的纯净原生IP机场推荐。低欺诈度分数，杜绝封号与报错1020。";
const keywords = "ChatGPT节点, Claude防封机场, AI专用机场, 原生IP节点, ChatGPT解锁";

const filtered = AIRPORTS.filter(a => a.aiSupport.length >= 3);
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath="recommend/ai/"
  currentNav="recommend"
>
  <section class="bg-white border-b border-slate-200 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-violet-50 text-violet-700 border border-violet-200 mb-4">
        AI 生产力大模型 · 纯净原生IP
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        2026年AI大模型与ChatGPT专用节点选购指南
      </h1>
      <p class="text-sm sm:text-base text-slate-600 mt-4 leading-relaxed">
        针对 OpenAI 与 Anthropic 严苛的风控规则，实机测试各品牌节点的 IP 欺诈度与纯净度。告别 Access Denied 报错与频繁要求手机验证。
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {filtered.map((a) => (
        <div class="bg-white rounded-2xl border border-slate-200 p-6 hover:shadow-lg transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2 py-0.5 rounded text-xs font-bold bg-violet-50 text-violet-700">#{a.rank} {a.name}</span>
              <span class="text-xs font-bold text-violet-600">原生住宅IP覆盖</span>
            </div>
            <p class="text-xs text-slate-500 mb-4 line-clamp-2 leading-relaxed">{a.tagline}</p>
            <div class="bg-slate-50 p-3 rounded-xl text-xs text-slate-600 mb-4 space-y-1">
              <div><strong>支持大模型：</strong> {a.aiSupport.join('、')}</div>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <a href={`/airport/${a.slug}/`} class="flex-1 py-2 rounded-xl text-center text-xs font-bold bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white transition-colors">
              评测详情 &rarr;
            </a>
            <a href={a.affUrl} target="_blank" rel="noopener nofollow" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700">
              官网 ↗
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
