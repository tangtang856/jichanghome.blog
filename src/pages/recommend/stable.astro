---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AIRPORTS } from '../../data/airports';

const title = "2026高稳定性机场推荐 | 晚高峰抗拥堵不掉线节点精选 - 机场之家";
const description = "精选高稳定性机场节点清单。针对晚高峰断流、国际骨干网QoS限速及特殊时期封锁进行了专项长期压力测试，保障企业与个人的长效稳定。";
const keywords = "稳定机场, 晚高峰不卡顿, 不掉线梯子, 防断连专线, 稳定网络节点";

const filtered = AIRPORTS.filter(a => a.rank <= 6 || a.lineType.includes('IPLC') || a.lineType.includes('IEPL'));
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath="recommend/stable/"
  currentNav="recommend"
>
  <section class="bg-white border-b border-slate-200 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 mb-4">
        长效坚挺 · 极低丢包
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        2026年高稳定性防断连机场节点推荐
      </h1>
      <p class="text-sm sm:text-base text-slate-600 mt-4 leading-relaxed">
        告别晚上八九点卡顿转圈。精选配备三网BGP冗余入口与物理专线的高稳定性节点，保障涉外远程协作与实时音视频不中断。
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {filtered.map((a) => (
        <div class="bg-white rounded-2xl border border-slate-200 p-6 hover:shadow-lg transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2 py-0.5 rounded text-xs font-bold bg-indigo-50 text-indigo-700">#{a.rank} {a.name}</span>
              <span class="text-xs font-bold text-emerald-600">丢包率 {a.benchmarks[0].loss}</span>
            </div>
            <p class="text-xs text-slate-500 mb-4 line-clamp-2 leading-relaxed">{a.tagline}</p>
          </div>
          <div class="flex items-center gap-2">
            <a href={`/airport/${a.slug}/`} class="flex-1 py-2 rounded-xl text-center text-xs font-bold bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white transition-colors">
              评测详情 &rarr;
            </a>
            <a href={a.affUrl} target="_blank" rel="noopener nofollow" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700">
              官网 ↗
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
