---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AIRPORTS } from '../../data/airports';

const title = "2026高端IPLC/IEPL专线机场推荐 | 4K高清与商务跨境选型 - 机场之家";
const description = "甄选全内网IPLC与IEPL物理专线机场。晚高峰抗拥堵、零丢包、全原生IP解锁，适合商务跨境、涉外办公与4K超清重度用户。";
const keywords = "高端专线机场, IPLC专线, IEPL专线, 商务机场, 4K极速节点";

const filtered = AIRPORTS.filter(a => a.lineType.includes('IPLC') || a.lineType.includes('IEPL'));
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath="recommend/premium/"
  currentNav="recommend"
>
  <section class="bg-white border-b border-slate-200 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 mb-4">
        高端旗舰 · 纯专线内网
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        2026年高端IPLC/IEPL内网专线机场推荐
      </h1>
      <p class="text-sm sm:text-base text-slate-600 mt-4 leading-relaxed">
        物理光纤直连跨境，数据不过GFW公网节点。晚高峰无视国际出口恶性拥堵，保障4K极速秒开与涉外会议流畅连接。
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {filtered.map((a) => (
        <div class="bg-white rounded-2xl border border-slate-200 p-6 hover:shadow-lg transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2 py-0.5 rounded text-xs font-bold bg-blue-50 text-blue-700">#{a.rank} {a.name}</span>
              <span class="text-xs font-bold text-blue-600">⭐ {a.scoreOverall}</span>
            </div>
            <p class="text-xs text-slate-500 mb-4 line-clamp-2 leading-relaxed">{a.tagline}</p>
            <div class="bg-slate-50 p-3 rounded-xl space-y-1.5 text-xs text-slate-600 mb-4">
              <div class="flex justify-between">
                <span>线路架构：</span>
                <strong class="text-slate-800">{a.lineType}</strong>
              </div>
              <div class="flex justify-between">
                <span>起步价格：</span>
                <strong class="text-red-600">¥{a.startingPrice}/月</strong>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <a href={`/airport/${a.slug}/`} class="flex-1 py-2 rounded-xl text-center text-xs font-bold bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white transition-colors">
              评测详情 &rarr;
            </a>
            <a href={a.affUrl} target="_blank" rel="noopener nofollow" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700">
              官网 ↗
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
