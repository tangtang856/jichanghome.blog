---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AIRPORTS } from '../../data/airports';

const title = "2026高性价比机场推荐排行榜 | 均价每GB成本透明对比 - 机场之家";
const description = "2026年高性价比平价机场推荐榜单。按照“官方套餐支付金额 / 实际可用流量”统一测算每GB单价并严格升序排序，微风网络、飞猫云等单GB单价低至¥0.04。";
const keywords = "性价比机场, 平价机场推荐, 便宜梯子, 单GB成本计算, 机场优惠码";

// Sort by unit price per GB ascending
const sortedByValue = [...AIRPORTS].sort((a, b) => a.plans[0].unitPricePerGb - b.plans[0].unitPricePerGb);
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath="ranking/value/"
  currentNav="ranking"
>
  <section class="bg-white border-b border-slate-200 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 mb-4">
        算法透明排序 · 拒付冤枉钱
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        2026年高性价比平价机场推荐排行榜
      </h1>
      <p class="text-sm sm:text-base text-slate-600 mt-4 leading-relaxed">
        严格基于公式 <strong>每GB真实成本 = 套餐价格 / 每月实际可用流量</strong> 升序排列。微风网络、飞猫云等单GB成本仅¥0.04左右，性价比冠绝全网。
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="space-y-4">
      {sortedByValue.map((a, idx) => (
        <div class="bg-white rounded-2xl border border-slate-200 p-5 hover:border-emerald-400 hover:shadow-md transition-all flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <span class="w-8 h-8 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-black text-xs">
              #{idx + 1}
            </span>
            <div>
              <div class="flex items-center gap-2">
                <h3 class="text-base font-black text-slate-900 hover:text-emerald-600">
                  <a href={`/airport/${a.slug}/`}>{a.name}</a>
                </h3>
                <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-100">{a.lineType}</span>
              </div>
              <p class="text-xs text-slate-400 mt-0.5">{a.tagline}</p>
            </div>
          </div>

          <div class="flex items-center gap-6 justify-between md:justify-end">
            <div class="text-right">
              <span class="text-[11px] text-slate-400 block">折算单GB价格</span>
              <span class="text-lg font-black text-emerald-600">¥{a.plans[0].unitPricePerGb}/GB</span>
            </div>
            <div class="text-right">
              <span class="text-[11px] text-slate-400 block">起步月付/流量</span>
              <span class="text-xs font-bold text-slate-800">¥{a.startingPrice}/月 ({a.plans[0].traffic})</span>
            </div>
            <a
              href={`/airport/${a.slug}/`}
              class="px-4 py-2 rounded-xl text-xs font-bold bg-emerald-50 text-emerald-700 hover:bg-emerald-600 hover:text-white transition-colors"
            >
              评测报告 &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
