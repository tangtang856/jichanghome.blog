---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "404 - 页面未找到 | 机场之家";
const description = "抱歉，您访问的页面不存在或已被移除。请返回机场之家首页浏览更多优质机场推荐与教程。";
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="404.html"
>
  <div class="min-h-[60vh] flex items-center justify-center py-16 px-4">
    <div class="max-w-md w-full text-center space-y-6 bg-white p-8 sm:p-10 rounded-3xl border border-slate-200 shadow-sm">
      <div class="w-16 h-16 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center font-black text-2xl mx-auto">
        404
      </div>
      <div class="space-y-2">
        <h1 class="text-2xl font-black text-slate-900">页面好像走丢了</h1>
        <p class="text-xs text-slate-500 leading-relaxed">
          您所访问的页面不存在、已被移动或链接输入有误。您可以尝试通过下方导航快速前往核心栏目。
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3 pt-2">
        <a href="/" class="py-2.5 px-4 rounded-xl text-xs font-bold bg-blue-600 text-white hover:bg-blue-700 shadow-sm">
          返回网站首页
        </a>
        <a href="/ranking/" class="py-2.5 px-4 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700">
          节点排行榜
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
