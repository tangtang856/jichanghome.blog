---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GLOSSARY_ITEMS } from '../../data/glossary';

const title = "科学上网专业术语与概念百科大全 - 机场之家";
const description = "收录IPLC专线、IEPL专线、Clash分流规则、Sub-Store订阅管理、TUN模式、双ISP住宅原生IP及节点倍率等核心科学上网术语深度解读。";
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="glossary/"
>
  <section class="bg-white border-b border-slate-200 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 mb-4">
        小白到老鸟必修课
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        科学上网核心网络技术术语百科
      </h1>
      <p class="text-sm text-slate-600 mt-4 leading-relaxed">
        弄清底层网络拓扑与软件技术概念，彻底杜绝虚高宣传与无良商家套路。
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {GLOSSARY_ITEMS.map((item) => (
        <a
          href={`/glossary/${item.slug}/`}
          class="bg-white rounded-2xl border border-slate-200 p-6 hover:shadow-lg hover:border-blue-400 transition-all flex flex-col justify-between group"
        >
          <div>
            <h2 class="text-base font-black text-slate-900 group-hover:text-blue-600 transition-colors mb-2">
              {item.term}
            </h2>
            <p class="text-xs text-slate-500 leading-relaxed line-clamp-3">
              {item.desc}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-blue-600">
            <span>查阅详细解读</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
