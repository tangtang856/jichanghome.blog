---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AIRPORTS } from '../../data/airports';

const title = "2026精选网络机场独立评测目录 | 14大主流品牌真实测速与资费解析 - 机场之家";
const description = "收录2026年主流已核验的14家高人气机场深度评测报告。涵盖微风网络、暮光网络、飞猫云、无忧、灵猫、闪跃、萤火虫、跨界、隐形人、飞V等真实套餐价格、节点晚高峰测速与专属优惠券。";
const keywords = "机场评测, 机场推荐, 梯子推荐, vpn, 节点测速, 微风网络, 暮光网络, 飞猫云, 闪跃, 隐形人";

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "url": "https://jichanghome.blog/airport/"
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath="airport/"
  currentNav="airport"
  schema={schema}
>
  <!-- Hero Section -->
  <section class="bg-white border-b border-slate-200 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 mb-4">
        14大主流已核验品牌独立深度评测
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        2026年网络机场独立深度评测数据库
      </h1>
      <p class="text-sm sm:text-base text-slate-600 mt-4 leading-relaxed">
        拒绝虚构跑分与盲目吹捧。机场之家采用统一客观测试标准，拆解各品牌真实底层拓扑、每GB折算成本、晚高峰晚20:00~23:00真实测速带宽与大模型解锁表现。
      </p>
    </div>
  </section>

  <!-- Airport Cards Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {AIRPORTS.map((airport) => {
        const mainPlan = airport.plans[0];
        return (
          <div class="bg-white rounded-2xl border border-slate-200 hover:border-blue-400 hover:shadow-lg transition-all p-6 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-black bg-blue-600 text-white">
                  #{airport.rank}
                </span>
                <span class="text-xs font-bold text-blue-600">
                  ⭐ {airport.scoreOverall} / 10
                </span>
              </div>

              <h2 class="text-xl font-black text-slate-900 group-hover:text-blue-600 transition-colors">
                <a href={`/airport/${airport.slug}/`}>{airport.name}</a>
              </h2>

              <div class="flex items-center gap-2 my-2">
                <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-700">
                  {airport.lineType}
                </span>
                <span class="text-xs text-slate-400">
                  起步 {mainPlan.traffic}
                </span>
              </div>

              <p class="text-xs text-slate-500 line-clamp-2 my-3 leading-relaxed">
                {airport.tagline}
              </p>

              <!-- Price Box -->
              <div class="bg-slate-50 rounded-xl p-3 my-4 flex items-center justify-between">
                <div>
                  <span class="text-[11px] text-slate-400 block">起步月付</span>
                  <span class="text-lg font-black text-red-600">¥{airport.startingPrice} <small class="text-xs text-slate-500 font-normal">/月</small></span>
                </div>
                <div class="text-right">
                  <span class="text-[11px] text-slate-400 block">单GB成本</span>
                  <span class="text-xs font-bold text-emerald-600">¥{mainPlan.unitPricePerGb}/GB</span>
                </div>
              </div>
            </div>

            <div class="pt-2 flex items-center gap-2">
              <a
                href={`/airport/${airport.slug}/`}
                class="flex-1 text-center py-2.5 rounded-xl text-xs font-bold bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white transition-colors"
              >
                查看独立评测报告 &rarr;
              </a>
              <a
                href={airport.affUrl}
                target="_blank"
                rel="noopener nofollow"
                class="px-3.5 py-2.5 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors"
                title="直达官方网站"
              >
                官网 ↗
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>
